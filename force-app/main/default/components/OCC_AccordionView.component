                <span class="col-xs-4 label-text-details">Item Description:</span>
                <span class="col-xs-4 label-text-details">Qty:</span>
                <span class="col-xs-2 label-text-details">Status:</span>
                <!-- <span class="col-xs-2 label-text-details">Total:</span> -->
            </div>
        </div>

    </div>
