                        </div>
                        <div ng-if="detail.TrackingURL__c" class="col-md-4  child-row">
                            <span class="label-text-details">Tracking No:</span>
                            <div>
                                <a href="{{::detail.TrackingURL__c}}" target="_blank">{{::detail.TrackingURL__c}}</a>
                            </div>
                        </div>
                    </div>
                </div>

                <!-- Added icon for shipping  based on % left-->
                <span ng-if="quote.header.Type__c == 'Order' && quote.header.Sub_Type__c != 'Change Order'">
                    <i ng-if="1 - (detail.Qty_Shipped__c / detail.Qty_Ordered__c) >= .3" class="glyphicon glyphicon-ok-circle qty-status" style="color:green"></i>
                    <i ng-if="1 - (detail.Qty_Shipped__c / detail.Qty_Ordered__c) < .3 && 1 - (detail.Qty_Shipped__c / detail.Qty_Ordered__c) != 0"
                        class="glyphicon glyphicon-exclamation-sign qty-status" style="color:#f0ad4e"></i>
                    <i ng-if="1 - (detail.Qty_Shipped__c / detail.Qty_Ordered__c) == 0" class="glyphicon glyphicon-ban-circle qty-status" style="color:red"></i>
                </span>

                <span ng-if="quote.header.Type__c == 'Release' || quote.header.Sub_Type__c == 'Change Order'">
                    <div class="receive">
                        <input ng-model="detail.Received_Complete__c" type="checkbox" style="float:left;" ng-change="receiveRequest(detail)" ng-true-value="'true'" ng-false-value="'false'"></input>
                        <span class="checkbox-label">Received</span>


                        <!-- <div class="checkbox-container">
                            <label class="checkbox-label">
                                <input type="checkbox"/>
                                <span class="checkbox-custom rectangular"></span>
                            </label>
                            <div class="input-title">Rectangular</div>
                        </div> -->

                    </div>
                   
                    <!-- <button ng-if="detail.Received_Complete__c == 'false'" class="qty-status receive" ng-model="detail.Received_Complete__c">Mark as Received</button> -->

                </span>
