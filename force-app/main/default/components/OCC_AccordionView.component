                        <!-- <div style="font-weight:bold; color:#0074BF;">
                            <a  ng-if="quote.header.Type__c == 'Release'" class="clickable" ng-href="{{::detail.Spec_Sheet__c}}" target="_blank"> {{::detail.Customer_Item__c}}</a>
                            <a  ng-if="quote.header.Type__c != 'Release'" class="clickable" ng-href="{{::detail.Spec_Sheet__c}}" target="_blank"> {{::detail.Cable_Code__c}}</a>
                        </div> -->
                    </div>
                    <div class="col-md-4 child-row">
                        <span class="label-text-details dynamic-detail-label">Item Description:</span>
                        <div>{{::detail.Item_Description__c}}</div>
                    </div>
                    <div class="col-md-4 child-row">
