                        <div>
                            <span class="qty-label">Ordered: </span>{{::detail.Qty_Ordered__c}}</div>
                        <div>
                            <span class="qty-label">Shipped: </span>{{::detail.Qty_Shipped__c}}</div>
                        <div>
                            <span class="qty-label">Remaining: </span>{{::(detail.Qty_Ordered__c - detail.Qty_Shipped__c)}}</div>
                    </div>
                    <!-- <div class="col-md-2  child-row"><span class="label-text-details dynamic-detail-label">Price:</span> <div>{{::detail.SalesPricePortal__c}}</div></div> -->

                    <div class="col-md-2 child-row">
                        <span class="label-text-details dynamic-detail-label">Status:</span>
                        <div>{{::detail.Line_Status__c}}</div>
                    </div>


                    <!-- <div class="col-md-2 row-padding child-row" ><div class="label-text-details dynamic-detail-label">Put-Ups:</div> 
                        <span ng-repeat="putup in detail.putups track by $index" style="padding:0px;">
                                {{::putup}}   
                        </span>
                    </div>  -->
                    <!-- <div class="col-md-2 child-row"><span class="label-text-details dynamic-detail-label">{{priceLabel}}:</span> <div>{{::detail.TotalDollarsPortal__c}}</div></div>  -->
                </div>

                <div ng-if="quote.header.Type__c == 'Release' || quote.header.Sub_Type__c == 'Change Order'">
                    <div class="col-md-12 row-padding">
                        
                        <div class="col-md-2 child-row">
                            <span class="label-text-details">Cable #:</span>
                            <div>{{::detail.Customer_Item__c}}</div>
                            
                            <!-- <div>{{::detail.cableNumber}}</div> -->
                            <!-- <div style="font-weight:bold; color:#0074BF;">
                                <a  class="clickable" ng-href="{{::detail.Spec_Sheet__c}}" target="_blank"> {{::detail.Line_Item__c}}</a>
                            </div> -->
                            <!-- <div>{{::detail.Line_Item__c}}</div> -->
                        </div>
                        
                        <div class="col-md-4 row-padding child-row">
                            <span class="label-text-details">Notes:</span>
                            <div>{{::detail.NotesPortal__c}}</div>
                        </div>

                        <div ng-if="!detail.TrackingURL__c" class="col-md-4  child-row">
                                <span class="label-text-details">Expected Ship Date:</span>
                                <div>{{::detail.Expected_Date__c}}</div>
                        </div>
                        <div ng-if="detail.TrackingURL__c" class="col-md-4  child-row">
                            <span class="label-text-details">Tracking No:</span>
                            <div>
                                <a href="{{::detail.TrackingURL__c}}" target="_blank">{{::detail.TrackingURL__c}}</a>
                            </div>
                        </div>

                        <div class="col-xs-12 child-row">
                            <span class="label-text-details">Item #:</span>
                            <div style="font-weight:bold; color:#0074BF;">
                                <a  class="clickable" ng-href="{{::detail.Spec_Sheet__c}}" target="_blank"> {{::detail.Line_Item__c}}</a>
                            </div>
                            <!-- <div>{{::detail.Line_Item__c}}</div> -->
                        </div>

                        <!-- <div class="col-md-6 row-padding child-row" ><div class="label-text-details">Put-Ups:</div> 
                            <span ng-repeat="putup in detail.putups track by $index" style="padding:0px;">
                                    {{::putup}}   
                            </span>
                        </div>  -->
                    </div>
                </div>
                <div ng-if="quote.header.Type__c == 'Order' && quote.header.Sub_Type__c != 'Change Order'">
                    <div class="col-md-12 row-padding">

                        <div class="col-md-2 child-row">
                            <span class="label-text-details">Item #:</span>
                            <div style="font-weight:bold; color:#0074BF;">
                                <a  class="clickable" ng-href="{{::detail.Spec_Sheet__c}}" target="_blank"> {{::detail.Line_Item__c}}</a>
                            </div>
                            <!-- <div>{{::detail.Line_Item__c}}</div> -->
                        </div>
                        <div class="col-md-4 row-padding child-row">
                            <span class="label-text-details">Notes:</span>
                            <div>{{::detail.NotesPortal__c}}</div>
                        </div>


                        <!-- <div class="col-md-4 row-padding child-row">
                            <div class="label-text-details">Put-Ups:</div>
                            <span ng-repeat="putup in detail.putups track by $index" style="padding:0px;">
                                {{::putup}}
                            </span>
                        </div> -->

                    </div>
                    <div class="col-md-12 row-padding">
                        <div class="col-md-2 child-row">
                            <span class="label-text-details">Freight Carrier:</span>
                            <div>{{::detail.Freight_Carrier__c}}</div>
                        </div>
                        <div class="col-md-4  child-row">
                            <span class="label-text-details">Freight Terms:</span>
                            <div>{{::detail.Freight_Terms__c}}</div>
                        </div>
                        <div ng-if="!detail.TrackingURL__c" class="col-md-4  child-row">
