                <div class="col-xs-2" style="margin: 0px; padding: 0px;">
                    <a href="{{::attachment.url}}" target="_blank" download="{{::attachment.title}}">
                        <img ng-src="{{::attachment.image}}" width="110" height="110" target="_blank" style="vertical-align:middle; border: 1px solid #337ab7;"
                        />
                    </a>
                    <span class="col-xs-12" style="text-align:center; margin-top:5px;">{{::attachment.title}}</span>
                </div>
            </div>
        </ul>
    </div>

    <div class="col-xs-12 row-padding" style="height:5px; background-color:#1E253A; margin-top:25px;"></div>

</apex:component>