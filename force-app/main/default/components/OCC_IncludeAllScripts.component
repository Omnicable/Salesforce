        <script>

            do_execute_service_callback = function(service, method, data, callback, show_loader) {
                
                setTimeout(function(){
                
                    if (show_loader){
                        $j.isLoading({ text: "Updating", class: "glyphicon glyphicon-refresh glyphicon-spin spin"});
                        
                    }
                    sforce.apex.execute(service, method, data,
                        {
                            onSuccess:function(postResult){
                            
                                if (show_loader){
                                    $j.isLoading( "hide" );
                                    
                                }
                                postResult = postResult[0];
                                callback(postResult);
                             },
                            onFailure: function(error){
               
                                if (show_loader){
                                    $j.isLoading( "hide" );
                                    
                                }                               
                                if( "faultcode" in error ) {
                                	alert(error);
                                	
                                    if(error["faultcode"] == "sf:INVALID_SESSION_ID") {
                                        window.location.href = '{!$Site.Prefix}/secur/logout.jsp';
                                    }else if (error["faultcode"] == "sf:INACTIVE_OWNER_OR_USER"){
                                        window.location.href = '{!$Site.Prefix}/secur/logout.jsp';
                                    } else{
                                    	//sf:INSUFFICIENT_ACCESS
                                    	window.location.href = '{!$Site.Prefix}/secur/logout.jsp';
                                    }
                                    
                                }else{
                                
	                                alert("There seems to be an issue with your network.  You've been logged out.  Please check your network connection and try again. \n\n Error Code: " +  error );
	                                window.location.href = '{!$Site.Prefix}/secur/logout.jsp';
                                
                                }
                            }  
                        });            
                },100);
            }
        
        
        </script>
        
