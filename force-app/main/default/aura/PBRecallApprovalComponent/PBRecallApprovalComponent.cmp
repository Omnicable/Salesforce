<aura:component controller="PriceSheetController" extends="c:PriceSheetBaseComponent"
	implements="force:lightningQuickAction,force:hasRecordId">

	<aura:handler name="init" value="{!this}" action="{!c.doInit}" />
	<aura:handler event="force:refreshView" action="{!c.doInit}" />
	<aura:attribute name="recordId" type="String" />
	<aura:attribute name="pba" type="Price_Book_Approval__c" />
	<aura:attribute name="isLoading" type="Boolean" />

	<div class="slds-is-relative">
		<div class="slds-text-heading_medium ">{!v.pba.Name}</div>
		<div class="slds-p-top_large">Are you sure you want to recall this request? This will return the the status to Not Ready and the request
			will be removed</div>

		<div class="sds-grid slds-gutters slds-grid_align-end slds-p-top_large">
			<lightning:button variant="destructive-text" label="RECALL APPROVAL REQUEST" title="RECALL APPROVAL REQUEST" onclick="{! c.recall }"/>
		</div>

		<lightning:spinner aura:id="mySpinner" class="{!v.isLoading ? 'slds-show': 'slds-hide'}"
		alternativeText="Loading" variant="brand" size="medium" />

		<lightning:notificationsLibrary aura:id="notifLib" />

	</div>

</aura:component>