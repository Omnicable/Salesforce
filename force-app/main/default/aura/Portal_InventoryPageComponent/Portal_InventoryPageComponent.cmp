<!--
  @description       : Inventory management page
  @author            : chrisw@launchdm.com
  @group             : LaunchDM
  @last modified on  : 12-21-2022
  @last modified by  : chrisw@launchdm.com
-->
<aura:component controller="Portal_ResourceController" access="global"
	implements="forceCommunity:availableForAllPageTypes">

	<aura:handler name="init" value="{!this}" action="{!c.doInit}" access="global" />
	<aura:attribute name="data" type="Object" />
	<aura:attribute name="columns" type="List" />
	<aura:attribute name="selectedRows" type="List" default="[]" />
	<aura:attribute name="selectedIds" type="List" default="[]" />
	<aura:attribute name="maxRowSelection" type="Integer" default="5" />
	<aura:attribute name="loading" type="Boolean" />
	<aura:attribute name="issearching" type="Boolean" />
	<aura:attribute name="bypass" type="Boolean" default="false" />
	<aura:attribute name="totalWeight" type="Integer" default="0" />
	<aura:import library="lightning:confirm" property="LightningConfirm" />
	<aura:handler name="paginationChange" event="c:Portal_PaginationEvent" action="{!c.onPaginationChange}" />
	<aura:attribute name="inventoryCount" type="Integer" default="10" />
	<aura:attribute name="itemsPerPage" type="Integer" default="25" />
	<aura:attribute name="offset" type="Integer" default="0" />
	<aura:attribute name="page" type="Integer" default="1" />


	<div class="slds-is-relative slds-var-p-horizontal_large slds-var-p-top_large main-cont">
		<div class="slds-grid slds-gutters slds-var-p-bottom_large">
			<div class="slds-col slds-col_bump-right" onkeyup="{! c.handleKeyUp }">
				<lightning:input aura:id="enter-search" name="enter-search" label="Search Inventory"
					isLoading="{! v.issearching }" type="search" oncommit="{!c.onClear}" />
			</div>
			<div class="slds-col slds-align-bottom slds-grow-none">
				<lightning:button class="warning" variant="base" label="X Clear Selections"
					disabled="{!v.selectedRows.length == 0}" onclick="{!c.clear}" />
			</div>
			<div class="slds-col slds-align-bottom slds-grow-none">
				<lightning:button variant="brand" label="Add to Release" disabled="{!v.selectedRows.length == 0}"
					onclick="{!c.addToRelease}" />
			</div>
		</div>
		<h1>Selected Rows: {! v.selectedRows.length }</h1>
		<lightning:datatable columns="{! v.columns }" data="{! v.data }" keyField="Id"
			onrowselection="{! c.updateSelectedText }" onrowaction="{! c.handleRowAction }"
			selectedRows="{! v.selectedIds }" isLoading="{!v.loading || v.issearching}" hideCheckboxColumn="true" />

		<div class="slds-grid slds-var-p-top_medium">
			<c:Portal_PaginationComponent aura:id="inventory" tab="inventory" itemsPerPage="{!v.itemsPerPage}"
				total="{!v.inventoryCount}" />
		</div>

		<aura:if isTrue="{!v.loading}">
			<lightning:spinner size="medium" title="Loading" />
		</aura:if>

		<lightning:overlayLibrary aura:id="overlayLib" />

		<!--
			Note: removed 8-22 per client request 
			<div aura:id="cart" class="cart h4">
			Total Estimated Weight:
			<lightning:formattedNumber value="{!v.totalWeight}" maximumFractionDigits="4" />
		</div> -->

	</div>

</aura:component>