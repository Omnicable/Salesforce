            <type>FieldUpdate</type>
        </actions>
        <actions>
            <name>Contact_Owner</name>
            <type>FieldUpdate</type>
        </actions>
        <active>true</active>
        <criteriaItems>
            <field>Contact.Active__c</field>
            <operation>equals</operation>
            <value>D</value>
        </criteriaItems>
        <description>Hope to have D&apos;s no longer show up I also changed Account and Contact Org sharing to Private.</description>
        <triggerType>onAllChanges</triggerType>
    </rules>
    <rules>
        <fullName>Buyer for new Contacts</fullName>
        <actions>
            <name>ContactBuyerFlag</name>
            <type>FieldUpdate</type>
        </actions>
        <active>true</active>
        <criteriaItems>
            <field>User.IsActive</field>
            <operation>equals</operation>
            <value>True</value>
        </criteriaItems>
        <criteriaItems>
            <field>Contact.Buyer__c</field>
            <operation>notEqual</operation>
            <value>Y,N</value>
        </criteriaItems>
        <description>Defaults blank Buyers to Contacts to N</description>
        <triggerType>onAllChanges</triggerType>
    </rules>
    <rules>
        <fullName>Deactivate contacts for D Accounts</fullName>
        <actions>
            <name>Deactivate_contacts</name>
            <type>FieldUpdate</type>
        </actions>
        <active>true</active>
        <criteriaItems>
            <field>Account.Active__c</field>
            <operation>equals</operation>
            <value>D</value>
        </criteriaItems>
        <triggerType>onAllChanges</triggerType>
    </rules>
    <rules>
        <fullName>Pardot Hard Bounce Email Updated</fullName>
        <actions>
            <name>Email_sent_to_Nikki_when_a_Pardot_Hard_Bounce_email_address_is_updated</name>
            <type>Alert</type>
        </actions>
        <active>false</active>
        <criteriaItems>
            <field>Contact.CreatedDate</field>
            <operation>notEqual</operation>
            <value>TODAY</value>
        </criteriaItems>
        <criteriaItems>
            <field>Contact.pi__pardot_hard_bounced__c</field>
            <operation>equals</operation>
            <value>False</value>
        </criteriaItems>
        <criteriaItems>
            <field>Contact.Active__c</field>
            <operation>equals</operation>
            <value>A</value>
        </criteriaItems>
        <criteriaItems>
            <field>User.FirstName</field>
            <operation>equals</operation>
            <value>John</value>
        </criteriaItems>
        <criteriaItems>
            <field>User.LastName</field>
            <operation>equals</operation>
            <value>Dean</value>
        </criteriaItems>
        <description>Rule to alert Nikki when a contact&apos;s email adress that hard bounced was updated to a new email address</description>
        <triggerType>onCreateOrTriggeringUpdate</triggerType>
    </rules>
</Workflow>
