    <fieldUpdates>
        <fullName>D_Contact_Add_zzz_to_First_Name</fullName>
        <description>Add &quot;zzz&quot; to the beginning of the contact&apos;s first name. This is done so that &quot;D&quot; Contacts are moved to the bottom of the Contacts related list on Accounts.</description>
        <field>FirstName</field>
        <formula>&quot;zzz&quot; + FirstName</formula>
        <name>D Contact - Add &quot;zzz&quot; to First Name</name>
        <notifyAssignee>false</notifyAssignee>
        <operation>Formula</operation>
        <protected>false</protected>
        <reevaluateOnChange>false</reevaluateOnChange>
    </fieldUpdates>
    <fieldUpdates>
        <fullName>D_Contact_Add_zzz_to_Last_Name</fullName>
        <description>Add &quot;zzz&quot; to the beginning of the contact&apos;s last name. This is done so that &quot;D&quot; Contacts are moved to the bottom of the Contacts related list on Accounts.</description>
        <field>LastName</field>
        <formula>&quot;zzz&quot; + LastName</formula>
        <name>D Contact - Add &quot;zzz&quot; to Last Name</name>
        <notifyAssignee>false</notifyAssignee>
        <operation>Formula</operation>
        <protected>false</protected>
        <reevaluateOnChange>false</reevaluateOnChange>
    </fieldUpdates>
    <fieldUpdates>
        <fullName>D_Contact_Add_zzz_to_email</fullName>
        <description>Add &quot;zzz&quot; to the beginning of the contact&apos;s email. This is done so that &quot;D&quot; Contacts are moved to the bottom and so there aren&apos;t duplicates later.</description>
        <field>Email</field>
        <formula>&quot;zzz&quot; + Email</formula>
        <name>D Contact - Add &quot;zzz&quot; to email</name>
        <notifyAssignee>false</notifyAssignee>
        <operation>Formula</operation>
        <protected>false</protected>
        <reevaluateOnChange>false</reevaluateOnChange>
    </fieldUpdates>
