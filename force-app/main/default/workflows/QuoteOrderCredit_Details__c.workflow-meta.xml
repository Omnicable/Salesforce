    <rules>
        <fullName>FFALinesCheckbox</fullName>
        <actions>
            <name>FFALinesCheckbox</name>
            <type>FieldUpdate</type>
        </actions>
        <active>true</active>
        <formula>Freight_Terms__c =&apos;FREIGHT ALLWD&apos; &amp;&amp;  Order_Header__r.FFA_Lines__c =FALSE &amp;&amp;
