    <fieldUpdates>
        <fullName>TrackingURL</fullName>
        <field>TrackingURL__c</field>
        <formula>IF(NOT(ISBLANK(Tracking_Number__c)),
IF(BEGINS(Freight_Carrier__c,&apos;UPS&apos;),&apos;https://wwwapps.ups.com/WebTracking/track?track=yes&amp;trackNums=&apos;+ Tracking_Number__c,
IF(BEGINS(Freight_Carrier__c,&apos;FED&apos;),&apos;https://www.fedex.com/apps/fedextrack/?tracknumbers=&apos;+ Tracking_Number__c,


&apos;https://www.google.com/search?q=&apos;+Freight_Carrier__c+&apos; &apos;+Tracking_Number__c
)),&apos;N/A&apos;)</formula>
        <name>TrackingURL</name>
        <notifyAssignee>false</notifyAssignee>
        <operation>Formula</operation>
        <protected>false</protected>
        <reevaluateOnChange>true</reevaluateOnChange>
    </fieldUpdates>
    <rules>
        <fullName>Belden Order %3E %241800</fullName>
        <active>false</active>
        <booleanFilter>1 AND 2 AND 3 AND 4 AND 5 AND 6</booleanFilter>
        <criteriaItems>
            <field>QuoteOrderCredit_Details__c.Item_Class__c</field>
            <operation>startsWith</operation>
            <value>BE,BL</value>
        </criteriaItems>
        <criteriaItems>
            <field>QuotesOrdersCredits_Header__c.Type__c</field>
            <operation>equals</operation>
            <value>Order</value>
        </criteriaItems>
        <criteriaItems>
            <field>QuotesOrdersCredits_Header__c.Status__c</field>
            <operation>notEqual</operation>
            <value>Cancelled</value>
        </criteriaItems>
        <criteriaItems>
            <field>QuoteOrderCredit_Details__c.Line_Status__c</field>
            <operation>notEqual</operation>
            <value>Cancelled</value>
        </criteriaItems>
        <criteriaItems>
            <field>QuotesOrdersCredits_Header__c.Region__c</field>
            <operation>equals</operation>
            <value>6</value>
        </criteriaItems>
        <criteriaItems>
            <field>QuotesOrdersCredits_Header__c.Total_Order_Sales__c</field>
            <operation>greaterThan</operation>
            <value>1800</value>
        </criteriaItems>
        <description>Send email to Kevin Dantley &amp; Ryan Horrell when a Belden order over $1800 is entered.</description>
        <triggerType>onAllChanges</triggerType>
    </rules>
    <rules>
        <fullName>Breaker Item Entered - check MCCM</fullName>
        <actions>
            <name>Check_MCCB_Box</name>
            <type>FieldUpdate</type>
        </actions>
        <active>true</active>
        <criteriaItems>
            <field>QuoteOrderCredit_Details__c.Class__c</field>
            <operation>equals</operation>
            <value>EA,SE</value>
        </criteriaItems>
        <criteriaItems>
            <field>QuotesOrdersCredits_Header__c.MCCB__c</field>
            <operation>equals</operation>
            <value>False</value>
        </criteriaItems>
        <criteriaItems>
            <field>QuoteOrderCredit_Details__c.Line_Status__c</field>
            <operation>notEqual</operation>
            <value>Cancelled</value>
        </criteriaItems>
        <description>Check the MCCB box on the QOC header if an item is class EA or SE

Updated 6/1/17: removed the email alert and changed 2nd line of criteria from type = quote to MCCB = false</description>
        <triggerType>onCreateOrTriggeringUpdate</triggerType>
    </rules>
