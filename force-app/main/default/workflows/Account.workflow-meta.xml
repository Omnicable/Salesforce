    <rules>
        <fullName>Account - No Activity Last 90 Days SSC</fullName>
        <active>false</active>
        <formula>ISPICKVAL(Active__c , &quot;A&quot;) &amp;&amp; 
((TODAY() -  LastActivityDate  &gt;  9 || ISNULL(LastActivityDate)) &amp;&amp;
(TODAY() - Max_Date_Order__c  &gt;  9 || ISNULL( Max_Date_Order__c))) &amp;&amp;
NOT(CONTAINS(Name, &quot;Omni Cable&quot;)) &amp;&amp;
OwnerId &lt;&gt; &quot;00560000001NBPM&quot; &amp;&amp;
$User.UserRoleId = &quot;00E600000017kt5&quot;</formula>
        <triggerType>onAllChanges</triggerType>
    </rules>
    <rules>
        <fullName>Account - SSC No Activity Last 60 Days</fullName>
        <active>true</active>
        <description>You&apos;ll receive a task if your account has had no activity in 60 days.</description>
        <formula>((TODAY() - LastActivityDate &gt; 60 || ISNULL(LastActivityDate)) &amp;&amp;
(TODAY() - Max_Date_Order__c &gt; 60 || ISNULL( Max_Date_Order__c))) &amp;&amp; 
ISPICKVAL(Active__c , &quot;A&quot;) &amp;&amp;
NOT(CONTAINS(Name, &quot;Omni Cable&quot;)) &amp;&amp;
ISPICKVAL( Type , &quot;Distributor&quot;) &amp;&amp;
$User.UserRoleId = &quot;00E600000017kt5&quot; ||
$Profile.Id =&quot;00e60000001BUuj&quot;</formula>
        <triggerType>onCreateOrTriggeringUpdate</triggerType>
        <workflowTimeTriggers>
            <actions>
                <name>No_Acitivity_60_Days</name>
                <type>Task</type>
            </actions>
            <offsetFromField>Account.Max_Date_Order__c</offsetFromField>
            <timeLength>60</timeLength>
            <workflowTimeTriggerUnit>Days</workflowTimeTriggerUnit>
        </workflowTimeTriggers>
    </rules>
    <rules>
        <fullName>Account Manager Extension</fullName>
        <actions>
            <name>Update_Account_Manager_Extension</name>
            <type>FieldUpdate</type>
        </actions>
        <active>true</active>
        <formula>(ISPICKVAL( Active__c , &apos;A&apos;) &amp;&amp;  ISBLANK( Account_Manager_Extension__c )) || ( ISCHANGED( Salesperson_Code__c ))</formula>
        <triggerType>onAllChanges</triggerType>
    </rules>
    <rules>
        <fullName>Assign D Account to Integration</fullName>
        <actions>
            <name>Change_Account_Owner_to_Integration</name>
            <type>FieldUpdate</type>
        </actions>
        <active>true</active>
        <criteriaItems>
            <field>Account.Active__c</field>
            <operation>equals</operation>
            <value>D</value>
        </criteriaItems>
        <triggerType>onAllChanges</triggerType>
    </rules>
    <rules>
        <fullName>FL Sales - No Activity for 30 Days</fullName>
        <actions>
            <name>Account_No_Activity_30_days</name>
            <type>Alert</type>
        </actions>
        <actions>
            <name>No_Activity_for_300_Days</name>
            <type>Task</type>
        </actions>
        <active>true</active>
        <description>Sends task to account manager if account has had no activity in 30 days</description>
        <formula>ISPICKVAL(Active__c , &quot;A&quot;) &amp;&amp;
((TODAY() - Max_Date_Order__c  &gt;  30 || ISNULL( Max_Date_Order__c))) &amp;&amp;
NOT(CONTAINS(Name, &quot;Omni Cable&quot;)) &amp;&amp;
(CONTAINS(Salesperson_Code__c, &quot;343&quot;)) &amp;&amp;
(CONTAINS(Salesperson_Code__c, &quot;342&quot;)) &amp;&amp;
(CONTAINS(Salesperson_Code__c, &quot;340&quot;)) &amp;&amp;
(CONTAINS(Salesperson_Code__c, &quot;339&quot;)) &amp;&amp;
(CONTAINS(Salesperson_Code__c, &quot;344&quot;)) &amp;&amp;
OwnerId &lt;&gt; &quot;00560000001NBPM&quot; &amp;&amp; 
OwnerId &lt;&gt; &quot;00560000001NoXZ&quot; &amp;&amp; 
( DATEVALUE(CreatedDate) &lt;&gt; TODAY())</formula>
        <triggerType>onCreateOrTriggeringUpdate</triggerType>
    </rules>
    <rules>
        <fullName>Initial Task</fullName>
        <actions>
            <name>Initial_Task</name>
            <type>Task</type>
        </actions>
        <active>true</active>
        <criteriaItems>
            <field>Account.Active__c</field>
            <operation>equals</operation>
            <value>A</value>
        </criteriaItems>
        <description>This creates an initial task for all accounts. Leave active because it will then work for new accounts and shouldn&apos;t be triggered again for existing accounts that it has already run for.</description>
        <triggerType>onCreateOrTriggeringUpdate</triggerType>
    </rules>
