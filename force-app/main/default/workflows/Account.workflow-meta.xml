    <rules>
        <fullName>Account Manager Extension</fullName>
        <actions>
            <name>Update_Account_Manager_Extension</name>
            <type>FieldUpdate</type>
        </actions>
        <active>true</active>
        <formula>(ISPICKVAL( Active__c , &apos;A&apos;) &amp;&amp;  ISBLANK( Account_Manager_Extension__c )) || ( ISCHANGED( Salesperson_Code__c ))</formula>
        <triggerType>onAllChanges</triggerType>
    </rules>
    <rules>
        <fullName>Assign D Account to Integration</fullName>
        <actions>
            <name>Change_Account_Owner_to_Integration</name>
            <type>FieldUpdate</type>
        </actions>
        <active>true</active>
        <criteriaItems>
            <field>Account.Active__c</field>
            <operation>equals</operation>
            <value>D</value>
        </criteriaItems>
        <triggerType>onAllChanges</triggerType>
    </rules>
    <rules>
        <fullName>Initial Task</fullName>
        <actions>
            <name>Initial_Task</name>
            <type>Task</type>
        </actions>
        <active>true</active>
        <criteriaItems>
            <field>Account.Active__c</field>
            <operation>equals</operation>
            <value>A</value>
        </criteriaItems>
        <description>This creates an initial task for all accounts. Leave active because it will then work for new accounts and shouldn&apos;t be triggered again for existing accounts that it has already run for.</description>
        <triggerType>onCreateOrTriggeringUpdate</triggerType>
    </rules>
    <rules>
        <fullName>Rebate Buying</fullName>
        <actions>
            <name>Set_Default_Rebate_Buying_Group</name>
            <type>FieldUpdate</type>
        </actions>
        <active>true</active>
        <criteriaItems>
            <field>Account.Type</field>
            <operation>equals</operation>
            <value>Distributor</value>
        </criteriaItems>
        <triggerType>onCreateOnly</triggerType>
    </rules>
    <rules>
        <fullName>Update Industrail Percentages</fullName>
        <actions>
            <name>Update_Industrial</name>
            <type>FieldUpdate</type>
        </actions>
        <active>true</active>
        <formula>ISPICKVAL(Active__c, &apos;A&apos;) &amp;&amp;   ISBLANK( Industrial__c )</formula>
        <triggerType>onAllChanges</triggerType>
    </rules>
    <rules>
        <fullName>Update Potential Percentages</fullName>
        <actions>
            <name>Customer_Potential</name>
            <type>FieldUpdate</type>
        </actions>
        <active>true</active>
        <formula>ISPICKVAL(Active__c, &apos;A&apos;) &amp;&amp;  ISBLANK(Commercial__c )</formula>
        <triggerType>onAllChanges</triggerType>
    </rules>
    <rules>
        <fullName>Update Residential Percentages</fullName>
        <actions>
            <name>Update_Resi</name>
            <type>FieldUpdate</type>
        </actions>
        <active>true</active>
        <formula>ISPICKVAL(Active__c, &apos;A&apos;) 
&amp;&amp;  ISBLANK( Residential__c )</formula>
        <triggerType>onAllChanges</triggerType>
    </rules>
