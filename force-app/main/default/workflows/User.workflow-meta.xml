    <fieldUpdates>
        <fullName>Update_ROC_Title</fullName>
        <field>ROC_Title__c</field>
        <formula>IF( 
BEGINS($UserRole.Name, &quot;Account Manager&quot;),&quot;Account Manager&quot;, 
IF ( 
BEGINS($UserRole.Name, &quot;District Sales Manager&quot;), &quot;Territory Sales Manager&quot;, 
IF ( 
BEGINS($UserRole.Name, &quot;Sales Manager&quot;), &quot;Account Manager&quot;, 
IF ( 
BEGINS($UserRole.Name, &quot;SSC Manager&quot;), &quot;Account Manager&quot;, 
IF ( 
BEGINS($UserRole.Name, &quot;SSC Sales&quot;), &quot;Account Manager&quot;, &quot;&quot;)))))</formula>
        <name>Update ROC Title</name>
        <notifyAssignee>false</notifyAssignee>
        <operation>Formula</operation>
        <protected>false</protected>
        <reevaluateOnChange>false</reevaluateOnChange>
    </fieldUpdates>
    <rules>
        <fullName>New User Created</fullName>
        <actions>
            <name>New_Omni_User_Created</name>
            <type>Alert</type>
        </actions>
        <active>true</active>
        <criteriaItems>
            <field>User.IsActive</field>
            <operation>equals</operation>
            <value>True</value>
        </criteriaItems>
        <triggerType>onCreateOnly</triggerType>
    </rules>
    <rules>
        <fullName>Populate ROC Title field on Omni Users</fullName>
        <actions>
            <name>Update_ROC_Title</name>
            <type>FieldUpdate</type>
        </actions>
        <active>false</active>
        <criteriaItems>
            <field>User.UserRoleId</field>
            <operation>contains</operation>
            <value>Account Manager,Sales Manager,SSC Sales,District Sales Manager,SSC Manager</value>
        </criteriaItems>
        <criteriaItems>
            <field>User.IsActive</field>
            <operation>equals</operation>
            <value>True</value>
        </criteriaItems>
        <description>The ROC Title field is the title to display for the account owner/outside salesperson on the new website. This allows the flexibility if the title of our outside salespeople changes, we can easily update this field.</description>
        <triggerType>onCreateOrTriggeringUpdate</triggerType>
    </rules>
</Workflow>
