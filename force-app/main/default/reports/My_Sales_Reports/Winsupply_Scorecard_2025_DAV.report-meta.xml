<?xml version="1.0" encoding="UTF-8"?>
<Report xmlns="http://soap.sforce.com/2006/04/metadata">
    <aggregates>
        <calculatedFormula>IF(Account.Sales_Year_Prior__c:SUM = 0, 0, (Account.Projected_EOY_Sales__c:SUM/Account.Sales_Year_Prior__c:SUM)-1)</calculatedFormula>
        <datatype>percent</datatype>
        <developerName>FORMULA1</developerName>
        <downGroupingContext>ACCOUNT.NAME</downGroupingContext>
        <isActive>true</isActive>
        <isCrossBlock>false</isCrossBlock>
        <masterLabel>Growth %</masterLabel>
        <scale>2</scale>
    </aggregates>
    <aggregates>
        <calculatedFormula>IF(
    Account.Sales_Year_Prior__c:SUM = 0, 0,
    IF(
        AND(
            (
                (Account.Projected_EOY_Sales__c:SUM / Account.Sales_Year_Prior__c:SUM) - 1
            ) &gt;= 0.05,
            (
                (Account.Projected_EOY_Sales__c:SUM / Account.Sales_Year_Prior__c:SUM) - 1
            ) &lt; 0.10
        ),
        0.005,
        IF(
            (
                (Account.Projected_EOY_Sales__c:SUM / Account.Sales_Year_Prior__c:SUM) - 1
            ) &gt;= 0.10,
            0.01,
            0
        )
    )
)</calculatedFormula>
        <datatype>percent</datatype>
        <developerName>FORMULA2</developerName>
        <isActive>true</isActive>
        <isCrossBlock>false</isCrossBlock>
        <masterLabel>Rebate %</masterLabel>
        <scale>2</scale>
    </aggregates>
    <aggregates>
        <calculatedFormula>IF(
    OR(
        Account.Sales_Year_Prior__c:SUM = 0, 
        (
            (Account.Projected_EOY_Sales__c:SUM / Account.Sales_Year_Prior__c:SUM) - 1
        ) &lt; 0.05
    ),
    0,
    IF(
        AND(
            (
                (Account.Projected_EOY_Sales__c:SUM / Account.Sales_Year_Prior__c:SUM) - 1
            ) &gt;= 0.05,
            (
                (Account.Projected_EOY_Sales__c:SUM / Account.Sales_Year_Prior__c:SUM) - 1
            ) &lt; 0.10
        ),
        Account.Projected_EOY_Sales__c:SUM * 0.005,
        Account.Projected_EOY_Sales__c:SUM * 0.01
    )
)</calculatedFormula>
        <datatype>currency</datatype>
        <developerName>FORMULA3</developerName>
        <isActive>true</isActive>
        <isCrossBlock>false</isCrossBlock>
        <masterLabel>Trending Payout</masterLabel>
        <scale>2</scale>
    </aggregates>
    <columns>
        <aggregateTypes>Sum</aggregateTypes>
        <field>Account.Sales_Current_Year__c</field>
    </columns>
    <columns>
        <aggregateTypes>Sum</aggregateTypes>
        <field>Account.Sales_Year_Prior__c</field>
    </columns>
    <columns>
        <aggregateTypes>Sum</aggregateTypes>
        <field>Account.Projected_EOY_Sales__c</field>
    </columns>
    <filter>
        <criteriaItems>
            <column>Account.Active__c</column>
            <columnToColumn>false</columnToColumn>
            <isUnlocked>true</isUnlocked>
            <operator>equals</operator>
            <value>A</value>
        </criteriaItems>
        <criteriaItems>
            <column>Account.Buying_Group__c</column>
            <columnToColumn>false</columnToColumn>
            <isUnlocked>true</isUnlocked>
            <operator>startsWith</operator>
            <value>Win</value>
        </criteriaItems>
        <language>en_US</language>
    </filter>
    <format>Summary</format>
    <groupingsDown>
        <dateGranularity>Day</dateGranularity>
        <field>ACCOUNT.NAME</field>
        <sortOrder>Asc</sortOrder>
    </groupingsDown>
    <name>Winsupply Scorecard 2026</name>
    <params>
        <name>co</name>
        <value>0</value>
    </params>
    <reportType>AccountList</reportType>
    <scope>organization</scope>
    <showDetails>false</showDetails>
    <showGrandTotal>false</showGrandTotal>
    <showSubTotals>false</showSubTotals>
    <timeFrameFilter>
        <dateColumn>CREATED_DATE</dateColumn>
        <interval>INTERVAL_CUSTOM</interval>
    </timeFrameFilter>
</Report>
