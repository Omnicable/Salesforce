<?xml version="1.0" encoding="UTF-8"?>
<SharingRules xmlns="http://soap.sforce.com/2006/04/metadata">
    <sharingCriteriaRules>
        <fullName>Account_Change_Requests</fullName>
        <accessLevel>Edit</accessLevel>
        <label>Account Change Requests</label>
        <sharedTo>
            <group>HR_Commissions_Group</group>
        </sharedTo>
        <criteriaItems>
            <field>RecordTypeId</field>
            <operation>equals</operation>
            <value>Budgets Request</value>
        </criteriaItems>
        <includeRecordsOwnedByAll>true</includeRecordsOwnedByAll>
    </sharingCriteriaRules>
    <sharingCriteriaRules>
        <fullName>IT_Access_to_all_IT_Cases</fullName>
        <accessLevel>Edit</accessLevel>
        <description>Anyone in the IT Public Group has read/write access to all Cases &amp; Request with Record Type IT Case</description>
        <label>IT Full Access to IT Cases</label>
        <sharedTo>
            <group>ITGroup</group>
        </sharedTo>
        <criteriaItems>
            <field>RecordTypeId</field>
            <operation>equals</operation>
            <value>IT Case,Standard</value>
        </criteriaItems>
        <includeRecordsOwnedByAll>false</includeRecordsOwnedByAll>
    </sharingCriteriaRules>
    <sharingCriteriaRules>
        <fullName>Marketing_Full_Access_to_Marketing_Tango_Card_Request</fullName>
        <accessLevel>Edit</accessLevel>
        <description>Anyone in the Marketing Public Group has read/write access to all Cases &amp; Request with Record Type Standard, Marketing Request, and Tango Card Request</description>
        <label>Marketing Full Access to Marketing/Tango Card Request</label>
        <sharedTo>
            <group>Marketing</group>
        </sharedTo>
        <criteriaItems>
            <field>RecordTypeId</field>
            <operation>equals</operation>
            <value>Tango Card Request,Marketing Request,Standard</value>
        </criteriaItems>
        <includeRecordsOwnedByAll>false</includeRecordsOwnedByAll>
    </sharingCriteriaRules>
</SharingRules>
