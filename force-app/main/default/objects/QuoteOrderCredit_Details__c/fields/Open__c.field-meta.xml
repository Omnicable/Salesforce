<?xml version="1.0" encoding="UTF-8"?>
<CustomField xmlns="http://soap.sforce.com/2006/04/metadata">
    <fullName>Open__c</fullName>
    <description>Sale Price of Quantity Open</description>
    <formula>IF (Qty_Ordered__c&gt;0,(( Dollars__c / Qty_Ordered__c ) *  Qty_Open__c), 0)</formula>
    <formulaTreatBlanksAs>BlankAsZero</formulaTreatBlanksAs>
    <inlineHelpText>Sale Price of Quantity Open</inlineHelpText>
    <label>$ Open</label>
    <precision>18</precision>
    <required>false</required>
    <scale>0</scale>
    <trackHistory>false</trackHistory>
    <trackTrending>false</trackTrending>
    <type>Currency</type>
</CustomField>
