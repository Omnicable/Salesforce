<?xml version="1.0" encoding="UTF-8"?>
<ValidationRule xmlns="http://soap.sforce.com/2006/04/metadata">
    <fullName>Validate_Plan_Year</fullName>
    <active>true</active>
    <errorConditionFormula>NOT(REGEX(Plan_Year__c, &quot;^[0-9]{4}$&quot;))</errorConditionFormula>
    <errorDisplayField>Plan_Year__c</errorDisplayField>
    <errorMessage>Please Enter a Valid 4 digit year.</errorMessage>
</ValidationRule>
