<?xml version="1.0" encoding="UTF-8"?>
<CustomField xmlns="http://soap.sforce.com/2006/04/metadata">
    <fullName>Order_Only__c</fullName>
    <description>Used to track order count in sales history reports that include releases and credits</description>
    <externalId>false</externalId>
    <formula>IF( 

ISPICKVAL( Type__c , &quot;Order&quot;)  ||  ISPICKVAL( Type__c , &quot;Release&quot;),


1,0)</formula>
    <formulaTreatBlanksAs>BlankAsZero</formulaTreatBlanksAs>
    <label>Order Only</label>
    <precision>18</precision>
    <required>false</required>
    <scale>0</scale>
    <trackHistory>false</trackHistory>
    <trackTrending>false</trackTrending>
    <type>Number</type>
    <unique>false</unique>
</CustomField>
