<?xml version="1.0" encoding="UTF-8"?>
<CustomField xmlns="http://soap.sforce.com/2006/04/metadata">
    <fullName>Total_Order_GP_with_BSD__c</fullName>
    <formula>IF(Total_Order_Sales__c=0,0,
   IF(Total_Order_Sales__c&gt;0, GP_w_BSD__c / Total_Order_Sales__c, 
       Total_Order_GP_Pct__c
     )
   )</formula>
    <formulaTreatBlanksAs>BlankAsZero</formulaTreatBlanksAs>
    <label>Total Order GP% with BSD (Booked)</label>
    <precision>18</precision>
    <required>false</required>
    <scale>2</scale>
    <trackHistory>false</trackHistory>
    <trackTrending>false</trackTrending>
    <type>Percent</type>
</CustomField>
