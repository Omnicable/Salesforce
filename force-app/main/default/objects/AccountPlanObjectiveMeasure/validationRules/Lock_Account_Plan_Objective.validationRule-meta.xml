<?xml version="1.0" encoding="UTF-8"?>
<ValidationRule xmlns="http://soap.sforce.com/2006/04/metadata">
    <fullName>Lock_Account_Plan_Objective</fullName>
    <active>true</active>
    <errorConditionFormula>AND(
OR(
ISPICKVAL(AccountPlanObjective.AccountPlan.Status , &quot;Completed&quot;),
ISPICKVAL(AccountPlanObjective.AccountPlan.Status, &quot;Active&quot;),
ISPICKVAL(AccountPlanObjective.AccountPlan.Status, &quot;Inactive&quot;)
),
NOT($Permission.Bypass_Account_Plan_Lock),
($User.Id &lt;&gt; &quot;00560000001NBBy&quot;),
($Profile.Id &lt;&gt; &quot;00e60000001BUtMAAW&quot;)
)</errorConditionFormula>
    <errorMessage>This Account Plan Objective is locked and cannot be modified after status is Complete, Active or Inactive.</errorMessage>
</ValidationRule>
