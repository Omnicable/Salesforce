    <description>Scheduled Flow that runs nightly after the Account data refresh to update current year. Account Plan values and actuals, preserve historical results and notify administrators of any failures</description>
    <environments>Default</environments>
    <formulas>
        <name>frmCurrentYear</name>
        <dataType>String</dataType>
        <expression>TEXT(YEAR($Flow.CurrentDate))</expression>
    </formulas>
    <formulas>
        <name>frmForecastRevenueCurrentValue</name>
        <dataType>String</dataType>
        <expression>TEXT({!Get_Related_Account.Sales_Current_Year__c})</expression>
    </formulas>
    <formulas>
        <name>frmMarginRateCurrentValue</name>
        <dataType>String</dataType>
        <expression>TEXT(ROUND({!Get_Related_Account.YTD_GP_Percentage__c}, 2))</expression>
    </formulas>
