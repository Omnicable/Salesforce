<?xml version="1.0" encoding="UTF-8"?>
<Flow xmlns="http://soap.sforce.com/2006/04/metadata">
    <apiVersion>65.0</apiVersion>
    <areMetricsLoggedToDataCloud>false</areMetricsLoggedToDataCloud>
    <assignments>
        <name>Capture_Update_Fault</name>
        <label>Capture Update Fault</label>
        <locationX>0</locationX>
        <locationY>0</locationY>
        <assignmentItems>
            <assignToReference>var_FaultMessage</assignToReference>
            <operator>Assign</operator>
            <value>
                <elementReference>$Flow.FaultMessage</elementReference>
            </value>
        </assignmentItems>
    </assignments>
    <decisions>
        <name>Has_Detail_Lookup</name>
        <label>Has Detail Lookup</label>
        <locationX>0</locationX>
        <locationY>0</locationY>
        <defaultConnectorLabel>No Detail</defaultConnectorLabel>
        <rules>
            <name>Detail_Is_Set</name>
            <conditionLogic>and</conditionLogic>
            <conditions>
                <leftValueReference>$Record.QuoteOrderCredit_Detail__c</leftValueReference>
                <operator>IsNull</operator>
                <rightValue>
                    <booleanValue>false</booleanValue>
                </rightValue>
            </conditions>
            <connector>
                <targetReference>Get_First_Vendor</targetReference>
            </connector>
            <label>Detail Is Set</label>
        </rules>
    </decisions>
    <decisions>
        <name>Has_Vendor</name>
        <label>Has Vendor</label>
        <locationX>0</locationX>
        <locationY>0</locationY>
        <defaultConnectorLabel>No Vendor Found</defaultConnectorLabel>
        <rules>
            <name>Vendor_Found</name>
            <conditionLogic>and</conditionLogic>
            <conditions>
                <leftValueReference>Get_First_Vendor</leftValueReference>
                <operator>IsNull</operator>
                <rightValue>
                    <booleanValue>false</booleanValue>
                </rightValue>
            </conditions>
            <connector>
                <targetReference>Update_Detail_Vendor_Fields</targetReference>
            </connector>
            <label>Vendor Found</label>
        </rules>
    </decisions>
    <description>When a Vendor is linked to a Quote/Order/Credit Detail, copies vendor fields from the first related Vendor record onto the detail (null-safe). Runs on a 1-minute scheduled path with graceful fault handling.</description>
    <environments>Default</environments>
    <formulas>
        <name>Safe_Vendor_Item</name>
        <dataType>String</dataType>
        <expression>BLANKVALUE({!Get_First_Vendor.Vendor_Item__c}, &quot;&quot;)</expression>
    </formulas>
    <formulas>
        <name>Safe_Vendor_Name</name>
        <dataType>String</dataType>
        <expression>BLANKVALUE({!Get_First_Vendor.Name}, &quot;&quot;)</expression>
    </formulas>
    <formulas>
        <name>Safe_Vendor_Number</name>
        <dataType>String</dataType>
        <expression>BLANKVALUE({!Get_First_Vendor.Vendor_Number__c}, &quot;&quot;)</expression>
    </formulas>
    <interviewLabel>Vendor Update Quote Detail Fields {!$Flow.CurrentDateTime}</interviewLabel>
    <label>Vendor Update Quote Detail Fields</label>
    <processMetadataValues>
        <name>BuilderType</name>
        <value>
            <stringValue>LightningFlowBuilder</stringValue>
        </value>
    </processMetadataValues>
    <processMetadataValues>
        <name>CanvasMode</name>
        <value>
            <stringValue>AUTO_LAYOUT_CANVAS</stringValue>
        </value>
    </processMetadataValues>
    <processMetadataValues>
        <name>OriginBuilderType</name>
        <value>
            <stringValue>LightningFlowBuilder</stringValue>
        </value>
    </processMetadataValues>
    <processType>AutoLaunchedFlow</processType>
    <recordLookups>
        <name>Get_First_Vendor</name>
        <label>Get First Vendor</label>
        <locationX>0</locationX>
        <locationY>0</locationY>
        <assignNullValuesIfNoRecordsFound>false</assignNullValuesIfNoRecordsFound>
        <connector>
            <targetReference>Has_Vendor</targetReference>
        </connector>
        <filterLogic>and</filterLogic>
        <filters>
            <field>QuoteOrderCredit_Detail__c</field>
            <operator>EqualTo</operator>
            <value>
                <elementReference>$Record.QuoteOrderCredit_Detail__c</elementReference>
            </value>
        </filters>
        <getFirstRecordOnly>true</getFirstRecordOnly>
        <object>Vendor__c</object>
        <queriedFields>CreatedDate</queriedFields>
        <queriedFields>Id</queriedFields>
        <queriedFields>Name</queriedFields>
        <queriedFields>Vendor_Item__c</queriedFields>
        <queriedFields>Vendor_Number__c</queriedFields>
        <sortField>CreatedDate</sortField>
        <sortOrder>Asc</sortOrder>
        <storeOutputAutomatically>true</storeOutputAutomatically>
    </recordLookups>
    <recordUpdates>
        <name>Update_Detail_Vendor_Fields</name>
        <label>Update Detail Vendor Fields</label>
        <locationX>0</locationX>
        <locationY>0</locationY>
        <faultConnector>
            <targetReference>Capture_Update_Fault</targetReference>
        </faultConnector>
        <filterLogic>and</filterLogic>
        <filters>
            <field>Id</field>
            <operator>EqualTo</operator>
            <value>
                <elementReference>$Record.QuoteOrderCredit_Detail__c</elementReference>
            </value>
        </filters>
        <inputAssignments>
            <field>Vendor_Item__c</field>
            <value>
                <elementReference>Safe_Vendor_Item</elementReference>
            </value>
        </inputAssignments>
        <inputAssignments>
            <field>Vendor_Name__c</field>
            <value>
                <elementReference>Safe_Vendor_Name</elementReference>
            </value>
        </inputAssignments>
        <inputAssignments>
            <field>Vendor_Number__c</field>
            <value>
                <elementReference>Safe_Vendor_Number</elementReference>
            </value>
        </inputAssignments>
        <object>QuoteOrderCredit_Details__c</object>
    </recordUpdates>
    <start>
        <locationX>0</locationX>
        <locationY>0</locationY>
        <filterLogic>and</filterLogic>
        <filters>
            <field>QuoteOrderCredit_Detail__c</field>
            <operator>IsNull</operator>
            <value>
                <booleanValue>false</booleanValue>
            </value>
        </filters>
        <object>Vendor__c</object>
        <recordTriggerType>CreateAndUpdate</recordTriggerType>
        <scheduledPaths>
            <name>X1_Minute_After_Save</name>
            <connector>
                <targetReference>Has_Detail_Lookup</targetReference>
            </connector>
            <label>1 Minute After Save</label>
            <offsetNumber>1</offsetNumber>
            <offsetUnit>Minutes</offsetUnit>
            <recordField>LastModifiedDate</recordField>
            <timeSource>RecordField</timeSource>
        </scheduledPaths>
        <triggerType>RecordAfterSave</triggerType>
    </start>
    <status>Draft</status>
    <variables>
        <name>var_FaultMessage</name>
        <dataType>String</dataType>
        <isCollection>false</isCollection>
        <isInput>false</isInput>
        <isOutput>false</isOutput>
    </variables>
</Flow>
