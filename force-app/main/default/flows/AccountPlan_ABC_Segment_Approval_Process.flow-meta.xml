<?xml version="1.0" encoding="UTF-8"?>
<Flow xmlns="http://soap.sforce.com/2006/04/metadata" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance">
    <apiVersion>68.0</apiVersion>
    <areMetricsLoggedToDataCloud>false</areMetricsLoggedToDataCloud>
    <decisions>
        <description>Check the RVP Approval Decision and routes the Account Plan to appropriate approved or rejected outcome</description>
        <name>Check_RVP_Approval_Outcome</name>
        <label>Check RVP Approval Outcome</label>
        <locationX>0</locationX>
        <locationY>0</locationY>
        <defaultConnectorLabel>Default Outcome</defaultConnectorLabel>
        <rules>
            <name>Approved</name>
            <conditionLogic>and</conditionLogic>
            <conditions>
                <leftValueReference>Approval_Step_1_of_RVP_ABC_Segment_Approval.Outputs.approvalDecision</leftValueReference>
                <operator>EqualTo</operator>
                <rightValue>
                    <stringValue>Approve</stringValue>
                </rightValue>
            </conditions>
            <connector>
                <targetReference>Update_AccountPlan_Approved</targetReference>
            </connector>
            <label>Approved</label>
        </rules>
        <rules>
            <name>Rejected</name>
            <conditionLogic>and</conditionLogic>
            <conditions>
                <leftValueReference>Approval_Step_1_of_RVP_ABC_Segment_Approval.Outputs.approvalDecision</leftValueReference>
                <operator>EqualTo</operator>
                <rightValue>
                    <stringValue>Reject</stringValue>
                </rightValue>
            </conditions>
            <connector>
                <targetReference>Update_Account_Plan_Rejected</targetReference>
            </connector>
            <label>Rejected</label>
        </rules>
    </decisions>
    <description>Manage Account Plan ABC Segment change request by routing approval to the RVP</description>
    <environments>Default</environments>
    <interviewLabel>AccountPlan - ABC Segment Approval Process {!$Flow.CurrentDateTime}</interviewLabel>
    <label>AccountPlan - ABC Segment Approval Process</label>
    <orchestratedStages>
        <description>Looks up the approver username. Approval steps cannot be assigned a user Id.</description>
        <name>Resolve_Approver</name>
        <label>Resolve Approver</label>
        <locationX>0</locationX>
        <locationY>0</locationY>
        <connector>
            <targetReference>RVP_ABC_Segment_Approval</targetReference>
        </connector>
        <exitConditionLogic>and</exitConditionLogic>
        <stageSteps>
            <name>Get_Approver_Username</name>
            <actionName>AccountPlan_ABC_Segment_Get_Approver_Username</actionName>
            <actionType>stepBackground</actionType>
            <assignees>
                <assignee>
                    <stringValue>nbabcock@omnicable.com.devpro2</stringValue>
                </assignee>
                <assigneeType>User</assigneeType>
            </assignees>
            <canAssigneeEdit>false</canAssigneeEdit>
            <debugSimulateStep>false</debugSimulateStep>
            <entryConditionLogic>and</entryConditionLogic>
            <exitConditionLogic>and</exitConditionLogic>
            <inputParameters>
                <name>userId</name>
                <value>
                    <elementReference>firstApprover</elementReference>
                </value>
            </inputParameters>
            <label>Get Approver Username</label>
            <outputConfigParams>
                <name>approverUsername</name>
                <value xsi:nil="true"/>
            </outputConfigParams>
            <requiresAsyncProcessing>false</requiresAsyncProcessing>
            <runAsUser>true</runAsUser>
            <shouldLock>false</shouldLock>
            <stepSubtype>BackgroundStep</stepSubtype>
        </stageSteps>
    </orchestratedStages>
    <orchestratedStages>
        <description>Routes Account Plan ABC Segment change request to the RVP or approval or rejection</description>
        <name>RVP_ABC_Segment_Approval</name>
        <label>RVP ABC Segment Approval</label>
        <locationX>0</locationX>
        <locationY>0</locationY>
        <connector>
            <targetReference>Check_RVP_Approval_Outcome</targetReference>
        </connector>
        <exitConditionLogic>and</exitConditionLogic>
        <stageSteps>
            <name>Approval_Step_1_of_RVP_ABC_Segment_Approval</name>
            <actionName>Review_Approval_Request_Accountplan</actionName>
            <actionType>stepApproval</actionType>
            <assignees>
                <assignee>
                    <elementReference>Get_Approver_Username.Outputs.approverUsername</elementReference>
                </assignee>
                <assigneeType>Resource</assigneeType>
            </assignees>
            <canAssigneeEdit>true</canAssigneeEdit>
            <debugSimulateStep>false</debugSimulateStep>
            <entryConditionLogic>and</entryConditionLogic>
            <exitConditionLogic>and</exitConditionLogic>
            <inputParameters>
                <name>approvalInformation</name>
                <value>
                    <elementReference>submissionComments</elementReference>
                </value>
            </inputParameters>
            <inputParameters>
                <name>recordId</name>
                <value>
                    <elementReference>recordId</elementReference>
                </value>
            </inputParameters>
            <inputParameters>
                <name>submitter</name>
                <value>
                    <elementReference>submitter</elementReference>
                </value>
            </inputParameters>
            <inputParameters>
                <name>ActionInput__RecordId</name>
                <value>
                    <elementReference>recordId</elementReference>
                </value>
            </inputParameters>
            <label>Approval Step 1 of RVP ABC Segment Approval</label>
            <requiresAsyncProcessing>false</requiresAsyncProcessing>
            <runAsUser>false</runAsUser>
            <shouldLock>true</shouldLock>
            <stepSubtype>ApprovalStep</stepSubtype>
        </stageSteps>
    </orchestratedStages>
    <orchestratedStages>
        <description>Update Account Plan verification and clear ABC Segment change request fields when RVP rejects the request</description>
        <name>Update_Account_Plan_Rejected</name>
        <label>Update Account Plan - Rejected</label>
        <locationX>0</locationX>
        <locationY>0</locationY>
        <exitConditionLogic>and</exitConditionLogic>
        <stageSteps>
            <name>Update_Account_Plan_After_Rejection</name>
            <actionName>AccountPlan_ABC_Segment_Rejected_Update_Record</actionName>
            <actionType>stepBackground</actionType>
