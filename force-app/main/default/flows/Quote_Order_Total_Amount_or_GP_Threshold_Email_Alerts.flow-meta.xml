<?xml version="1.0" encoding="UTF-8"?>
<Flow xmlns="http://soap.sforce.com/2006/04/metadata">
    <apiVersion>65.0</apiVersion>
    <areMetricsLoggedToDataCloud>false</areMetricsLoggedToDataCloud>
    <description>in the Get Header Record Element, replaced GPpct__c with Total_Order_GP_Pct__c.</description>
    <environments>Default</environments>
    <interviewLabel>Quote/Order Total Amount or GP Threshold Email Alerts {!$Flow.CurrentDateTime}</interviewLabel>
    <label>Quote/Order Total Amount or GP Threshold Email Alerts</label>
    <processMetadataValues>
        <name>BuilderType</name>
        <value>
            <stringValue>LightningFlowBuilder</stringValue>
        </value>
    </processMetadataValues>
    <processMetadataValues>
        <name>CanvasMode</name>
        <value>
            <stringValue>AUTO_LAYOUT_CANVAS</stringValue>
        </value>
    </processMetadataValues>
    <processMetadataValues>
        <name>OriginBuilderType</name>
        <value>
            <stringValue>LightningFlowBuilder</stringValue>
        </value>
    </processMetadataValues>
    <processType>AutoLaunchedFlow</processType>
    <recordLookups>
        <description>Get record status and field values for the quote/order record that triggered the flow interview.</description>
        <name>Get_Header_Record_Field_Values</name>
        <label>Get Header Record Field Values</label>
        <locationX>0</locationX>
        <locationY>0</locationY>
        <assignNullValuesIfNoRecordsFound>false</assignNullValuesIfNoRecordsFound>
        <connector>
            <targetReference>CSC_quote_under_2500_and_GP_under_30_Email_Alert_Subflow</targetReference>
        </connector>
        <filterLogic>and</filterLogic>
        <filters>
            <field>Id</field>
            <operator>EqualTo</operator>
            <value>
                <elementReference>$Record.Id</elementReference>
            </value>
        </filters>
        <getFirstRecordOnly>true</getFirstRecordOnly>
        <object>QuotesOrdersCredits_Header__c</object>
        <queriedFields>Id</queriedFields>
        <queriedFields>Entered_By__c</queriedFields>
        <queriedFields>Total_Order_Sales__c</queriedFields>
        <queriedFields>Total_Order_GP_Pct__c</queriedFields>
        <queriedFields>Type__c</queriedFields>
        <queriedFields>Region__c</queriedFields>
        <queriedFields>Customer_Number__c</queriedFields>
        <queriedFields>Total_Order_GP__c</queriedFields>
        <queriedFields>GPpct__c</queriedFields>
        <storeOutputAutomatically>true</storeOutputAutomatically>
    </recordLookups>
    <start>
        <locationX>0</locationX>
        <locationY>0</locationY>
        <filterLogic>(1 AND 3) OR (2 AND 4)</filterLogic>
        <filters>
            <field>Type__c</field>
            <operator>EqualTo</operator>
            <value>
                <stringValue>Quote</stringValue>
            </value>
        </filters>
        <filters>
            <field>Type__c</field>
            <operator>EqualTo</operator>
            <value>
                <stringValue>Order</stringValue>
            </value>
        </filters>
        <filters>
            <field>Status__c</field>
            <operator>NotEqualTo</operator>
            <value>
                <stringValue>Closed</stringValue>
            </value>
        </filters>
        <filters>
            <field>Status__c</field>
            <operator>NotEqualTo</operator>
            <value>
                <stringValue>Cancelled</stringValue>
            </value>
        </filters>
        <object>QuotesOrdersCredits_Header__c</object>
        <recordTriggerType>Create</recordTriggerType>
        <scheduledPaths>
            <name>Delay_for_Formula_Field_Calculation</name>
            <connector>
                <targetReference>Get_Header_Record_Field_Values</targetReference>
            </connector>
            <label>Delay for Formula Field Calculation</label>
            <offsetNumber>5</offsetNumber>
            <offsetUnit>Minutes</offsetUnit>
            <timeSource>RecordTriggerEvent</timeSource>
        </scheduledPaths>
        <triggerType>RecordAfterSave</triggerType>
    </start>
    <status>Active</status>
    <subflows>
        <name>CED_quote_50K_or_order_25K_Subflow</name>
        <label>CED quote &gt; $50K or order &gt; $25K Subflow</label>
        <locationX>0</locationX>
        <locationY>0</locationY>
        <flowName>CED_Quote_Order_Email_Alert_Subflow</flowName>
        <inputAssignments>
            <name>GetQOCHeaderRecordVariable</name>
            <value>
                <elementReference>Get_Header_Record_Field_Values</elementReference>
            </value>
        </inputAssignments>
    </subflows>
    <subflows>
        <name>CSC_quote_under_2500_and_GP_under_30_Email_Alert_Subflow</name>
        <label>CSC quote &lt;$2.5K and GP &lt;30% Email Alert Subflow</label>
        <locationX>0</locationX>
        <locationY>0</locationY>
        <connector>
            <targetReference>R14_New_Quote_Order_under_15_GP_Subflow</targetReference>
        </connector>
        <flowName>CSC_quote_under_2500_and_GP_under_30_Email_Alert</flowName>
        <inputAssignments>
            <name>GetQOCHeaderRecordVariable</name>
            <value>
                <elementReference>Get_Header_Record_Field_Values</elementReference>
            </value>
        </inputAssignments>
    </subflows>
    <subflows>
        <name>R14_New_Quote_Order_under_15_GP_Subflow</name>
        <label>R14 New Quote Order &lt;15% GP Subflow</label>
        <locationX>0</locationX>
        <locationY>0</locationY>
        <connector>
            <targetReference>CED_quote_50K_or_order_25K_Subflow</targetReference>
        </connector>
        <flowName>R14_New_Quote_Order_15_GP</flowName>
        <inputAssignments>
            <name>GetQOCHeaderRecordVariable</name>
            <value>
                <elementReference>Get_Header_Record_Field_Values</elementReference>
            </value>
        </inputAssignments>
    </subflows>
</Flow>
