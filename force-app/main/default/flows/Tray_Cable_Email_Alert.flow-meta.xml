    <decisions>
        <description>Quote/Order contains Tray Cable products and 1. account is in Bill’s list OR 2. ≥$50K in Tray Cable and not entered by the LOD team.</description>
        <name>Tray_Cable_50K</name>
        <label>Tray Cable &gt;0 for Certain Accounts or &gt;50K</label>
        <locationX>0</locationX>
        <locationY>0</locationY>
        <defaultConnectorLabel>Tray Cable &lt; 50K</defaultConnectorLabel>
        <rules>
            <name>Tray_Cable_50K_Plus</name>
            <conditionLogic>(1 AND 2) OR (3 AND 4)</conditionLogic>
            <conditions>
                <leftValueReference>GetRecordVariable.Tray_Cable_dollars__c</leftValueReference>
                <operator>GreaterThanOrEqualTo</operator>
                <rightValue>
                    <numberValue>50000.0</numberValue>
                </rightValue>
            </conditions>
            <conditions>
                <leftValueReference>GetRecordVariable.Entered_By__r.Department</leftValueReference>
                <operator>NotEqualTo</operator>
                <rightValue>
                    <stringValue>Large Order Department</stringValue>
                </rightValue>
            </conditions>
            <conditions>
                <leftValueReference>GetRecordVariable.Tray_Cable_dollars__c</leftValueReference>
                <operator>GreaterThan</operator>
                <rightValue>
                    <numberValue>0.0</numberValue>
                </rightValue>
            </conditions>
            <conditions>
                <leftValueReference>IsInAccountList</leftValueReference>
                <operator>EqualTo</operator>
                <rightValue>
                    <booleanValue>true</booleanValue>
                </rightValue>
            </conditions>
            <connector>
                <targetReference>Get_Tray_Cable_Email_Distribution_List_User_IDs</targetReference>
            </connector>
            <label>Tray Cable &gt;0 for Specific Accounts or &gt;=50K</label>
        </rules>
    </decisions>
