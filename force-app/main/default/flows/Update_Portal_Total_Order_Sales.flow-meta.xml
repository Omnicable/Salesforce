<?xml version="1.0" encoding="UTF-8"?>
<Flow xmlns="http://soap.sforce.com/2006/04/metadata">
    <apiVersion>66.0</apiVersion>
    <areMetricsLoggedToDataCloud>false</areMetricsLoggedToDataCloud>
    <description>The Portal Total Order Sales is no longer coming from DWH.  We have to update this values so that customers can receive their Reel Rewards</description>
    <environments>Default</environments>
    <interviewLabel>Update Portal Total Order Sales {!$Flow.CurrentDateTime}</interviewLabel>
    <label>Update Portal Total Order Sales</label>
    <processMetadataValues>
        <name>BuilderType</name>
        <value>
            <stringValue>LightningFlowBuilder</stringValue>
        </value>
    </processMetadataValues>
    <processMetadataValues>
        <name>CanvasMode</name>
        <value>
            <stringValue>AUTO_LAYOUT_CANVAS</stringValue>
        </value>
    </processMetadataValues>
    <processMetadataValues>
        <name>OriginBuilderType</name>
        <value>
            <stringValue>LightningFlowBuilder</stringValue>
        </value>
    </processMetadataValues>
    <processType>AutoLaunchedFlow</processType>
    <recordUpdates>
        <name>Set_New_Order_Total</name>
        <label>Set New Order Total</label>
        <locationX>0</locationX>
        <locationY>0</locationY>
        <inputAssignments>
            <field>New_Total_Order_Sales__c</field>
            <value>
                <elementReference>$Record.TotalDollars__c</elementReference>
            </value>
        </inputAssignments>
        <inputReference>$Record</inputReference>
    </recordUpdates>
    <start>
        <locationX>0</locationX>
        <locationY>0</locationY>
        <connector>
            <targetReference>Set_New_Order_Total</targetReference>
        </connector>
        <filterLogic>and</filterLogic>
        <filters>
            <field>TotalDollars__c</field>
            <operator>IsChanged</operator>
            <value>
                <booleanValue>true</booleanValue>
            </value>
        </filters>
        <object>QuotesOrdersCredits_Header__c</object>
        <recordTriggerType>CreateAndUpdate</recordTriggerType>
        <triggerType>RecordBeforeSave</triggerType>
    </start>
    <status>Active</status>
</Flow>
