<?xml version="1.0" encoding="UTF-8"?>
<Flow xmlns="http://soap.sforce.com/2006/04/metadata">
    <apiVersion>68.0</apiVersion>
    <areMetricsLoggedToDataCloud>false</areMetricsLoggedToDataCloud>
    <decisions>
        <name>Check_Objective_Measures</name>
        <label>Check Objective Measures</label>
        <locationX>0</locationX>
        <locationY>0</locationY>
        <defaultConnectorLabel>Default Outcome</defaultConnectorLabel>
        <rules>
            <name>Objective_Measures_Found</name>
            <conditionLogic>and</conditionLogic>
            <conditions>
                <leftValueReference>Get_Parent_Account_Plan_Obejective.Id</leftValueReference>
                <operator>IsNull</operator>
                <rightValue>
                    <booleanValue>false</booleanValue>
                </rightValue>
            </conditions>
            <conditions>
                <leftValueReference>Get_Margin_Measures.Id</leftValueReference>
                <operator>IsNull</operator>
                <rightValue>
                    <booleanValue>false</booleanValue>
                </rightValue>
            </conditions>
            <conditions>
                <leftValueReference>Get_Revenue_Measure.Id</leftValueReference>
                <operator>IsNull</operator>
                <rightValue>
                    <booleanValue>false</booleanValue>
                </rightValue>
            </conditions>
            <connector>
                <targetReference>Update_Acccount_Plan_Targets</targetReference>
            </connector>
            <label>Objective Measures Found</label>
        </rules>
    </decisions>
    <description>Automatically updates the Target Revenue and Target Margin Percentage fields on the related Account Plan when the corresponding Account Plan Objective Measures target value are created or updated.</description>
    <environments>Default</environments>
    <interviewLabel>Update Account Plan Targets From Obejctive Measures {!$Flow.CurrentDateTime}</interviewLabel>
    <label>Update Account Plan Targets From Obejctive Measures</label>
    <processMetadataValues>
        <name>BuilderType</name>
        <value>
            <stringValue>LightningFlowBuilder</stringValue>
        </value>
    </processMetadataValues>
    <processMetadataValues>
        <name>CanvasMode</name>
        <value>
            <stringValue>AUTO_LAYOUT_CANVAS</stringValue>
        </value>
    </processMetadataValues>
    <processMetadataValues>
        <name>OriginBuilderType</name>
        <value>
            <stringValue>LightningFlowBuilder</stringValue>
        </value>
    </processMetadataValues>
    <processType>AutoLaunchedFlow</processType>
    <recordLookups>
        <name>Get_Margin_Measures</name>
        <label>Get Margin Measures</label>
        <locationX>0</locationX>
        <locationY>0</locationY>
        <assignNullValuesIfNoRecordsFound>false</assignNullValuesIfNoRecordsFound>
        <connector>
            <targetReference>Check_Objective_Measures</targetReference>
        </connector>
        <filterLogic>and</filterLogic>
        <filters>
            <field>AccountPlanObjectiveId</field>
            <operator>EqualTo</operator>
            <value>
                <elementReference>$Record.AccountPlanObjectiveId</elementReference>
            </value>
        </filters>
        <filters>
            <field>ValueType</field>
            <operator>EqualTo</operator>
            <value>
                <stringValue>Percent</stringValue>
            </value>
        </filters>
        <getFirstRecordOnly>true</getFirstRecordOnly>
        <object>AccountPlanObjectiveMeasure</object>
        <storeOutputAutomatically>true</storeOutputAutomatically>
    </recordLookups>
    <recordLookups>
        <name>Get_Parent_Account_Plan_Obejective</name>
        <label>Get Parent Account Plan Obejective</label>
        <locationX>0</locationX>
        <locationY>0</locationY>
        <assignNullValuesIfNoRecordsFound>false</assignNullValuesIfNoRecordsFound>
        <connector>
            <targetReference>Get_Revenue_Measure</targetReference>
        </connector>
        <filterLogic>and</filterLogic>
        <filters>
            <field>Id</field>
            <operator>EqualTo</operator>
            <value>
                <elementReference>$Record.AccountPlanObjective.Id</elementReference>
            </value>
        </filters>
        <getFirstRecordOnly>true</getFirstRecordOnly>
        <object>AccountPlanObjective</object>
        <storeOutputAutomatically>true</storeOutputAutomatically>
    </recordLookups>
    <recordLookups>
        <name>Get_Revenue_Measure</name>
        <label>Get Revenue Measure</label>
        <locationX>0</locationX>
        <locationY>0</locationY>
        <assignNullValuesIfNoRecordsFound>false</assignNullValuesIfNoRecordsFound>
        <connector>
            <targetReference>Get_Margin_Measures</targetReference>
        </connector>
        <filterLogic>and</filterLogic>
        <filters>
            <field>AccountPlanObjectiveId</field>
            <operator>EqualTo</operator>
            <value>
                <elementReference>$Record.AccountPlanObjectiveId</elementReference>
            </value>
        </filters>
        <filters>
            <field>ValueType</field>
            <operator>EqualTo</operator>
            <value>
                <stringValue>Currency</stringValue>
            </value>
        </filters>
        <getFirstRecordOnly>true</getFirstRecordOnly>
        <object>AccountPlanObjectiveMeasure</object>
        <storeOutputAutomatically>true</storeOutputAutomatically>
    </recordLookups>
    <recordUpdates>
        <name>Update_Acccount_Plan_Targets</name>
        <label>Update Acccount Plan Targets</label>
        <locationX>0</locationX>
        <locationY>0</locationY>
        <filterLogic>and</filterLogic>
        <filters>
            <field>Id</field>
            <operator>EqualTo</operator>
            <value>
                <elementReference>Get_Parent_Account_Plan_Obejective.AccountPlanId</elementReference>
            </value>
        </filters>
        <inputAssignments>
            <field>Target_Margin_Percentage__c</field>
            <value>
                <elementReference>Get_Margin_Measures.TargetPercentValue</elementReference>
            </value>
        </inputAssignments>
        <inputAssignments>
            <field>Target_Revenue__c</field>
            <value>
                <elementReference>Get_Revenue_Measure.TargetCurrencyValue</elementReference>
            </value>
        </inputAssignments>
        <object>AccountPlan</object>
    </recordUpdates>
    <start>
        <locationX>0</locationX>
        <locationY>0</locationY>
        <connector>
            <targetReference>Get_Parent_Account_Plan_Obejective</targetReference>
        </connector>
        <object>AccountPlanObjectiveMeasure</object>
        <recordTriggerType>CreateAndUpdate</recordTriggerType>
        <triggerType>RecordAfterSave</triggerType>
    </start>
    <status>Active</status>
</Flow>
