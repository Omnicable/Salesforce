    <decisions>
        <description>Is record a R14 quote or order with GP &lt;15%?</description>
        <name>R14_Quote_Order_with_GP_under_15</name>
        <label>R14 Quote/Order with GP &lt;15%</label>
        <locationX>0</locationX>
        <locationY>0</locationY>
        <defaultConnectorLabel>No Not R14 quote/order with GP &lt;15%</defaultConnectorLabel>
        <rules>
            <name>Yes_R14_quote_order_with_GP_under_15</name>
            <conditionLogic>(1 OR 2) AND 3 AND 4 AND 5</conditionLogic>
            <conditions>
                <leftValueReference>GetQOCHeaderRecordVariable.Region__c</leftValueReference>
                <operator>EqualTo</operator>
                <rightValue>
                    <stringValue>014</stringValue>
                </rightValue>
            </conditions>
            <conditions>
                <leftValueReference>GetQOCHeaderRecordVariable.Region__c</leftValueReference>
                <operator>EqualTo</operator>
                <rightValue>
                    <stringValue>014</stringValue>
                </rightValue>
            </conditions>
            <conditions>
                <leftValueReference>GetQOCHeaderRecordVariable.Total_Order_GP_Pct__c</leftValueReference>
                <operator>LessThan</operator>
                <rightValue>
                    <numberValue>15.0</numberValue>
                </rightValue>
            </conditions>
            <conditions>
                <leftValueReference>GetQOCHeaderRecordVariable.Total_Order_GP__c</leftValueReference>
                <operator>IsNull</operator>
                <rightValue>
                    <booleanValue>false</booleanValue>
                </rightValue>
            </conditions>
            <conditions>
                <leftValueReference>GetQOCHeaderRecordVariable.Total_Order_GP__c</leftValueReference>
                <operator>NotEqualTo</operator>
                <rightValue>
                    <numberValue>0.0</numberValue>
                </rightValue>
            </conditions>
            <connector>
                <targetReference>Get_R14_quote_order_with_GP_under_15_Email_Distribution_List_User_IDs</targetReference>
            </connector>
            <label>Yes R14 quote/order with GP &lt;15%</label>
        </rules>
    </decisions>
