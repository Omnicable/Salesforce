                </rightValue>
            </conditions>
            <conditions>
                <leftValueReference>GetQOCHeaderRecordVariable.Total_Order_Sales__c</leftValueReference>
                <operator>LessThan</operator>
                <rightValue>
                    <numberValue>2500.0</numberValue>
