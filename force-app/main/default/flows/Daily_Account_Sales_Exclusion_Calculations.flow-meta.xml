<?xml version="1.0" encoding="UTF-8"?>
<Flow xmlns="http://soap.sforce.com/2006/04/metadata">
    <apiVersion>68.0</apiVersion>
    <areMetricsLoggedToDataCloud>false</areMetricsLoggedToDataCloud>
    <assignments>
        <description>Accumulates the excluded from Account sales amount from each qualifying order to calculate the current year total for the Account</description>
        <name>Calculate_Total_Excluded_Sales</name>
        <label>Calculate Total Excluded Sales</label>
        <locationX>0</locationX>
        <locationY>0</locationY>
        <assignmentItems>
            <assignToReference>varTotalExcludedSales</assignToReference>
            <operator>Add</operator>
            <value>
                <elementReference>Loop_through_excluded_sales.Excluded_from_Account_Sales__c</elementReference>
            </value>
        </assignmentItems>
        <connector>
            <targetReference>Loop_through_excluded_sales</targetReference>
        </connector>
    </assignments>
    <description>Daily scheduled flow that calculates qualifying order level adjusted total order value amounts for each Account and updates the CY Excluded from Account Sales Field</description>
    <environments>Default</environments>
    <interviewLabel>Daily Account Sales Exclusion Calculations {!$Flow.CurrentDateTime}</interviewLabel>
    <label>Daily Account Sales Exclusion Calculations</label>
    <loops>
        <name>Loop_through_excluded_sales</name>
        <label>Loop through excluded sales</label>
        <locationX>0</locationX>
        <locationY>0</locationY>
        <collectionReference>Get_Excluded_Sales_Records</collectionReference>
        <iterationOrder>Asc</iterationOrder>
        <nextValueConnector>
            <targetReference>Calculate_Total_Excluded_Sales</targetReference>
        </nextValueConnector>
        <noMoreValuesConnector>
            <targetReference>Update_Account_Excluded_Sales</targetReference>
        </noMoreValuesConnector>
    </loops>
    <processMetadataValues>
        <name>BuilderType</name>
        <value>
            <stringValue>LightningFlowBuilder</stringValue>
        </value>
    </processMetadataValues>
    <processMetadataValues>
        <name>CanvasMode</name>
        <value>
            <stringValue>AUTO_LAYOUT_CANVAS</stringValue>
        </value>
    </processMetadataValues>
    <processMetadataValues>
        <name>OriginBuilderType</name>
        <value>
            <stringValue>LightningFlowBuilder</stringValue>
        </value>
    </processMetadataValues>
    <processType>AutoLaunchedFlow</processType>
    <recordLookups>
        <name>Get_Excluded_Sales_Records</name>
        <label>Get Excluded Sales Records</label>
        <locationX>0</locationX>
        <locationY>0</locationY>
        <assignNullValuesIfNoRecordsFound>false</assignNullValuesIfNoRecordsFound>
        <connector>
            <targetReference>Loop_through_excluded_sales</targetReference>
        </connector>
        <filterLogic>and</filterLogic>
        <filters>
            <field>AccountId</field>
            <operator>EqualTo</operator>
            <value>
                <elementReference>$Record.Id</elementReference>
            </value>
        </filters>
        <filters>
            <field>EffectiveDate</field>
            <operator>GreaterThanOrEqualTo</operator>
            <value>
                <dateValue>2026-01-01</dateValue>
            </value>
        </filters>
        <filters>
            <field>EffectiveDate</field>
            <operator>LessThan</operator>
            <value>
                <dateValue>2027-01-01</dateValue>
            </value>
        </filters>
        <getFirstRecordOnly>false</getFirstRecordOnly>
        <object>Order</object>
        <storeOutputAutomatically>true</storeOutputAutomatically>
    </recordLookups>
    <recordUpdates>
        <description>Update the Account current year excluded sale total based on qualifying orders</description>
        <name>Update_Account_Excluded_Sales</name>
        <label>Update Account Excluded Sales</label>
        <locationX>0</locationX>
        <locationY>0</locationY>
        <inputAssignments>
            <field>CY_Excluded_From_Account_Sales__c</field>
            <value>
                <elementReference>varTotalExcludedSales</elementReference>
            </value>
        </inputAssignments>
        <inputReference>$Record</inputReference>
    </recordUpdates>
    <start>
        <locationX>0</locationX>
        <locationY>0</locationY>
        <connector>
            <targetReference>Get_Excluded_Sales_Records</targetReference>
        </connector>
        <object>Account</object>
        <schedule>
            <frequency>Daily</frequency>
            <startDate>2026-11-20</startDate>
            <startTime>23:30:00.000Z</startTime>
        </schedule>
        <triggerType>Scheduled</triggerType>
    </start>
    <status>Draft</status>
    <variables>
        <name>varTotalExcludedSales</name>
        <dataType>Currency</dataType>
        <isCollection>false</isCollection>
        <isInput>false</isInput>
        <isOutput>false</isOutput>
        <scale>2</scale>
        <value>
            <numberValue>0.0</numberValue>
        </value>
    </variables>
</Flow>
