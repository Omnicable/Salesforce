        <queriedFields>Aluminum_dollars__c</queriedFields>
        <queriedFields>Commercial_Cord_dollars__c</queriedFields>
        <queriedFields>EWS_dollars__c</queriedFields>
        <queriedFields>Customer_Number__c</queriedFields>
        <queriedFields>Molex_Total_line__c</queriedFields>
        <storeOutputAutomatically>true</storeOutputAutomatically>
    </recordLookups>
    <start>
        <locationX>0</locationX>
        <locationY>0</locationY>
        <filterLogic>(1 AND 3) OR (2 AND 4)</filterLogic>
        <filters>
            <field>Type__c</field>
