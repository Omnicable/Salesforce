        <description>Confirm record is still open.</description>
        <name>Record_Still_Open</name>
        <label>Record Still Open?</label>
        <locationX>0</locationX>
        <locationY>0</locationY>
        <defaultConnectorLabel>Is Closed</defaultConnectorLabel>
        <rules>
            <name>Still_Open</name>
            <conditionLogic>and</conditionLogic>
            <conditions>
                <leftValueReference>Get_Header_Record_Field_Values.Order_Number__c</leftValueReference>
                <operator>NotEqualTo</operator>
            </conditions>
            <connector>
                <targetReference>Industrial_Cord_Email_Alert_Subflow</targetReference>
            </connector>
            <label>Still Open</label>
        </rules>
    </decisions>
