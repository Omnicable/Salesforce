<?xml version="1.0" encoding="UTF-8"?>
<Flow xmlns="http://soap.sforce.com/2006/04/metadata">
    <apiVersion>68.0</apiVersion>
    <areMetricsLoggedToDataCloud>false</areMetricsLoggedToDataCloud>
    <assignments>
        <name>Set_Plan_Key</name>
        <label>Set Plan Key</label>
        <locationX>0</locationX>
        <locationY>0</locationY>
        <assignmentItems>
            <assignToReference>$Record.Plan_Key__c</assignToReference>
            <operator>Assign</operator>
            <value>
                <elementReference>frmPlanKey</elementReference>
            </value>
        </assignmentItems>
    </assignments>
    <decisions>
        <name>Check_Account_and_Plan_Year</name>
        <label>Check Account and Plan Year</label>
        <locationX>0</locationX>
        <locationY>0</locationY>
        <defaultConnectorLabel>Default Outcome</defaultConnectorLabel>
        <rules>
            <name>Both_Values_Present</name>
            <conditionLogic>and</conditionLogic>
            <conditions>
                <leftValueReference>$Record.AccountId</leftValueReference>
                <operator>IsNull</operator>
                <rightValue>
                    <booleanValue>false</booleanValue>
                </rightValue>
            </conditions>
            <conditions>
                <leftValueReference>$Record.Plan_Year__c</leftValueReference>
                <operator>IsNull</operator>
                <rightValue>
                    <booleanValue>false</booleanValue>
                </rightValue>
            </conditions>
            <connector>
                <targetReference>Set_Plan_Key</targetReference>
            </connector>
            <label>Both Values Present</label>
        </rules>
    </decisions>
    <description>Automatically generates a unique plan key using the  AccountId and Plan Year before an Account Plan is saved. Preventing duplicate plans  for the same Account and Year.</description>
    <environments>Default</environments>
    <formulas>
        <name>frmPlanKey</name>
        <dataType>String</dataType>
        <expression>{!$Record.AccountId} &amp; &quot;-&quot; &amp; {!$Record.Plan_Year__c}</expression>
    </formulas>
    <interviewLabel>Account Plan - Generate Unique Plan Key {!$Flow.CurrentDateTime}</interviewLabel>
    <label>Account Plan - Generate Unique Plan Key</label>
    <processMetadataValues>
        <name>BuilderType</name>
        <value>
            <stringValue>LightningFlowBuilder</stringValue>
        </value>
    </processMetadataValues>
    <processMetadataValues>
        <name>CanvasMode</name>
        <value>
            <stringValue>AUTO_LAYOUT_CANVAS</stringValue>
        </value>
    </processMetadataValues>
    <processMetadataValues>
        <name>OriginBuilderType</name>
        <value>
            <stringValue>LightningFlowBuilder</stringValue>
        </value>
    </processMetadataValues>
    <processType>AutoLaunchedFlow</processType>
    <start>
        <locationX>0</locationX>
        <locationY>0</locationY>
        <connector>
            <targetReference>Check_Account_and_Plan_Year</targetReference>
        </connector>
        <object>AccountPlan</object>
        <recordTriggerType>CreateAndUpdate</recordTriggerType>
        <triggerType>RecordBeforeSave</triggerType>
    </start>
    <status>Active</status>
</Flow>
