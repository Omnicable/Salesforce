<?xml version="1.0" encoding="UTF-8"?>
<ApprovalProcess xmlns="http://soap.sforce.com/2006/04/metadata">
    <active>true</active>
    <allowRecall>true</allowRecall>
    <allowedSubmitters>
        <type>creator</type>
    </allowedSubmitters>
    <approvalPageFields>
        <field>Marketing_Budget__c</field>
        <field>Name</field>
        <field>CreatedBy</field>
        <field>Length_of_Promotion__c</field>
        <field>Start_Date__c</field>
        <field>End_Date__c</field>
        <field>Promo_Format__c</field>
        <field>Other_Format_Prize__c</field>
        <field>Promo_Customer_Contact__c</field>
        <field>Approved_by_Customer_Management__c</field>
        <field>Targeted_Product_s__c</field>
        <field>Targeted_Sales_During_Promotion__c</field>
        <field>Targeted_Salesperson_s__c</field>
        <field>Communication_Plan__c</field>
        <field>Additional_Information__c</field>
        <field>Status__c</field>
        <field>LastModifiedBy</field>
    </approvalPageFields>
    <approvalStep>
        <allowDelegate>true</allowDelegate>
        <approvalActions>
            <action>
                <name>Your_promotion_has_been_approved</name>
                <type>Alert</type>
            </action>
        </approvalActions>
        <assignedApprover>
            <approver>
                <name>jdean@omnicable.com</name>
                <type>user</type>
            </approver>
            <whenMultipleApprovers>FirstResponse</whenMultipleApprovers>
        </assignedApprover>
        <description>Marketing must review and approve promo.</description>
        <entryCriteria>
            <criteriaItems>
                <field>Promo__c.RecordType</field>
                <operation>equals</operation>
                <value>Customer Promotion</value>
            </criteriaItems>
        </entryCriteria>
        <ifCriteriaNotMet>RejectRecord</ifCriteriaNotMet>
        <label>Marketing Promo Approval</label>
        <name>RM_Promo_Approval</name>
        <rejectionActions>
            <action>
                <name>Change_status</name>
                <type>FieldUpdate</type>
            </action>
            <action>
                <name>Promotion_Request_rejected</name>
                <type>Alert</type>
            </action>
        </rejectionActions>
    </approvalStep>
    <description>Updated 4.27 to make Marketing the only approver.</description>
    <emailTemplate>Marketing_Templates/Email_to_Current_Approver</emailTemplate>
    <enableMobileDeviceAccess>false</enableMobileDeviceAccess>
    <entryCriteria>
        <formula>RecordType.Name  = &quot;Customer Promotion&quot;</formula>
    </entryCriteria>
    <finalApprovalActions>
        <action>
            <name>Change_Status_Approved2</name>
            <type>FieldUpdate</type>
        </action>
        <action>
            <name>Your_promotion_has_been_approved</name>
            <type>Alert</type>
        </action>
    </finalApprovalActions>
    <finalApprovalRecordLock>false</finalApprovalRecordLock>
    <finalRejectionRecordLock>false</finalRejectionRecordLock>
    <initialSubmissionActions>
        <action>
            <name>Change_Status_to_Pending_Mrktng_Approval</name>
            <type>FieldUpdate</type>
        </action>
        <action>
            <name>Promotion_Request_Submitted_for_Approval</name>
            <type>Alert</type>
        </action>
    </initialSubmissionActions>
    <label>Promotion Request Final 4.27.17</label>
    <nextAutomatedApprover>
        <useApproverFieldOfRecordOwner>false</useApproverFieldOfRecordOwner>
        <userHierarchyField>Manager</userHierarchyField>
    </nextAutomatedApprover>
    <processOrder>1</processOrder>
    <recordEditability>AdminOrCurrentApprover</recordEditability>
    <showApprovalHistory>true</showApprovalHistory>
</ApprovalProcess>
