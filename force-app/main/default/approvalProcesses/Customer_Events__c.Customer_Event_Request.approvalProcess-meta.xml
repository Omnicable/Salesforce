<?xml version="1.0" encoding="UTF-8"?>
<ApprovalProcess xmlns="http://soap.sforce.com/2006/04/metadata">
    <active>true</active>
    <allowRecall>true</allowRecall>
    <allowedSubmitters>
        <type>creator</type>
    </allowedSubmitters>
    <allowedSubmitters>
        <type>owner</type>
    </allowedSubmitters>
    <approvalPageFields>
        <field>CreatedBy</field>
        <field>Name</field>
        <field>Amount__c</field>
        <field>Customer_Account__c</field>
        <field>Customer_Salesperson__c</field>
        <field>YTD_Sales__c</field>
        <field>YTD_GP__c</field>
        <field>Prior_Year_Sales__c</field>
        <field>Prior_Year_GP__c</field>
        <field>Reason_for_Credit__c</field>
        <field>Marketing_Budget__c</field>
        <field>Status__c</field>
        <field>LastModifiedBy</field>
    </approvalPageFields>
    <approvalStep>
        <allowDelegate>false</allowDelegate>
        <approvalActions>
            <action>
                <name>Customer_Event_Credit_Request_Approved_by_1st_Approver_RM_or_RVP</name>
                <type>Alert</type>
            </action>
            <action>
                <name>Update_Status_to_Pending_Approval</name>
                <type>FieldUpdate</type>
            </action>
        </approvalActions>
        <assignedApprover>
            <approver>
                <type>userHierarchyField</type>
            </approver>
        </assignedApprover>
        <label>Step 1 for All Requests</label>
        <name>Request_Under_1500</name>
        <rejectionActions>
            <action>
                <name>Customer_Event_Credit_Request_Approved_by_1st_Approver_RM_or_RVP_to_creator_sfdc</name>
                <type>Alert</type>
            </action>
            <action>
                <name>Update_Status_to_Rejected</name>
                <type>FieldUpdate</type>
            </action>
        </rejectionActions>
    </approvalStep>
    <approvalStep>
        <allowDelegate>false</allowDelegate>
        <approvalActions>
            <action>
                <name>Customer_Event_Credit_Request_Approved_by_1st_Approver_RM_or_RVP</name>
                <type>Alert</type>
            </action>
            <action>
                <name>Update_Status_to_Pending_Approval</name>
                <type>FieldUpdate</type>
            </action>
        </approvalActions>
        <assignedApprover>
            <approver>
                <type>userHierarchyField</type>
            </approver>
        </assignedApprover>
        <entryCriteria>
            <booleanFilter>1</booleanFilter>
            <criteriaItems>
                <field>User.UserRole</field>
                <operation>startsWith</operation>
                <value>Corporate</value>
            </criteriaItems>
        </entryCriteria>
        <ifCriteriaNotMet>ApproveRecord</ifCriteriaNotMet>
        <label>Request from 2nd Approver if AM/DSM created request</label>
        <name>Request_from_2nd_Approver</name>
        <rejectBehavior>
            <type>BackToPrevious</type>
        </rejectBehavior>
        <rejectionActions>
            <action>
                <name>Customer_Event_Credit_Request_Approved_by_1st_Approver_RM_or_RVP_to_creator_sfdc</name>
                <type>Alert</type>
            </action>
            <action>
                <name>Update_Status_to_Rejected</name>
                <type>FieldUpdate</type>
            </action>
        </rejectionActions>
    </approvalStep>
    <approvalStep>
        <allowDelegate>false</allowDelegate>
        <approvalActions>
            <action>
                <name>Change_Status_toapproved</name>
                <type>FieldUpdate</type>
            </action>
        </approvalActions>
        <assignedApprover>
            <approver>
                <type>userHierarchyField</type>
            </approver>
        </assignedApprover>
        <description>Has already been approved by the RM &amp; RVP - if it&apos;s $1500+, the request now goes to the COO</description>
        <entryCriteria>
            <criteriaItems>
                <field>Customer_Events__c.Amount__c</field>
                <operation>greaterOrEqual</operation>
                <value>1500</value>
            </criteriaItems>
        </entryCriteria>
        <label>Request $1500+ going to COO for approval</label>
        <name>Request_1500s</name>
        <rejectBehavior>
            <type>BackToPrevious</type>
        </rejectBehavior>
        <rejectionActions>
            <action>
                <name>Customer_Event_Credit_Request_Approved_by_1st_Approver_RM_or_RVP_to_creator_sfdc</name>
                <type>Alert</type>
            </action>
            <action>
                <name>Update_Status_to_Rejected</name>
                <type>FieldUpdate</type>
            </action>
        </rejectionActions>
    </approvalStep>
    <emailTemplate>Stacy_s_Working_Folder/Customer_Event_Request</emailTemplate>
    <enableMobileDeviceAccess>false</enableMobileDeviceAccess>
    <entryCriteria>
        <criteriaItems>
            <field>Customer_Events__c.Amount__c</field>
            <operation>greaterOrEqual</operation>
            <value>0</value>
        </criteriaItems>
        <criteriaItems>
            <field>User.UserRole</field>
            <operation>notEqual</operation>
            <value>EVP Sales Operations</value>
        </criteriaItems>
    </entryCriteria>
    <finalApprovalActions>
        <action>
            <name>Customer_Event_Credit_Request_Approved_by_all</name>
            <type>Alert</type>
        </action>
    </finalApprovalActions>
    <finalApprovalRecordLock>true</finalApprovalRecordLock>
    <finalRejectionRecordLock>false</finalRejectionRecordLock>
    <initialSubmissionActions>
        <action>
            <name>Customer_Event_Request_Submitted_Notification_to_creator_and_Stacy</name>
            <type>Alert</type>
        </action>
    </initialSubmissionActions>
    <label>Customer Event Request</label>
    <nextAutomatedApprover>
        <useApproverFieldOfRecordOwner>false</useApproverFieldOfRecordOwner>
        <userHierarchyField>Manager</userHierarchyField>
    </nextAutomatedApprover>
    <processOrder>1</processOrder>
    <recordEditability>AdminOrCurrentApprover</recordEditability>
    <showApprovalHistory>true</showApprovalHistory>
</ApprovalProcess>
