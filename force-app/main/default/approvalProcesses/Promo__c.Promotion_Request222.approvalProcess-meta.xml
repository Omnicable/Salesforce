<?xml version="1.0" encoding="UTF-8"?>
<ApprovalProcess xmlns="http://soap.sforce.com/2006/04/metadata">
    <active>false</active>
    <allowRecall>true</allowRecall>
    <allowedSubmitters>
        <type>creator</type>
    </allowedSubmitters>
    <approvalPageFields>
        <field>Marketing_Budget__c</field>
        <field>Name</field>
        <field>CreatedBy</field>
        <field>Length_of_Promotion__c</field>
        <field>Start_Date__c</field>
        <field>End_Date__c</field>
        <field>Promo_Format__c</field>
        <field>Other_Format_Prize__c</field>
        <field>Promo_Customer_Contact__c</field>
        <field>Approved_by_Customer_Management__c</field>
        <field>Targeted_Product_s__c</field>
        <field>Targeted_Sales_During_Promotion__c</field>
        <field>Targeted_Salesperson_s__c</field>
        <field>Communication_Plan__c</field>
        <field>Additional_Information__c</field>
        <field>Status__c</field>
        <field>LastModifiedBy</field>
    </approvalPageFields>
    <approvalStep>
        <allowDelegate>true</allowDelegate>
        <approvalActions>
            <action>
                <name>Change_Status_to_Pending</name>
                <type>FieldUpdate</type>
            </action>
            <action>
                <name>Your_promotion_has_been_approved</name>
                <type>Alert</type>
            </action>
        </approvalActions>
        <assignedApprover>
            <approver>
                <name>mbrady@omnicable.com</name>
                <type>user</type>
            </approver>
            <whenMultipleApprovers>FirstResponse</whenMultipleApprovers>
        </assignedApprover>
        <description>Once Marketing approves, the request goes to the RM (or submitter&apos;s manager) for Approval.</description>
        <entryCriteria>
            <criteriaItems>
                <field>Promo__c.RecordType</field>
                <operation>equals</operation>
                <value>Customer Promotion</value>
            </criteriaItems>
        </entryCriteria>
        <ifCriteriaNotMet>RejectRecord</ifCriteriaNotMet>
        <label>Promo Approval from Marketing</label>
        <name>Marketing_Promo_Approval</name>
        <rejectionActions>
            <action>
                <name>Change_Status_to_Rejected</name>
                <type>FieldUpdate</type>
            </action>
            <action>
                <name>Promotion_Request_rejected</name>
                <type>Alert</type>
            </action>
        </rejectionActions>
    </approvalStep>
    <approvalStep>
        <allowDelegate>true</allowDelegate>
        <approvalActions>
            <action>
                <name>Promotion_Request_Approved_by_RM</name>
                <type>Alert</type>
            </action>
        </approvalActions>
        <assignedApprover>
            <approver>
                <type>userHierarchyField</type>
            </approver>
        </assignedApprover>
        <description>RM must approve the promotion for their region.</description>
        <entryCriteria>
            <criteriaItems>
                <field>Promo__c.RecordType</field>
                <operation>equals</operation>
                <value>Customer Promotion</value>
            </criteriaItems>
            <criteriaItems>
                <field>Promo__c.Manager_Role__c</field>
                <operation>notContain</operation>
                <value>Regional Manager</value>
            </criteriaItems>
        </entryCriteria>
        <label>RM Promo Approval - 2nd approver</label>
        <name>RM_Promo_Approval_2nd_approver</name>
        <rejectBehavior>
            <type>BackToPrevious</type>
        </rejectBehavior>
        <rejectionActions>
            <action>
                <name>Change_Status_to_Rejected</name>
                <type>FieldUpdate</type>
            </action>
            <action>
                <name>Promotion_Request_rejected</name>
                <type>Alert</type>
            </action>
        </rejectionActions>
    </approvalStep>
    <description>Switched Marketing to be 1st approver and RM as 2nd approver. RVP is on 1st and last email alerts, but not an actual approver.</description>
    <emailTemplate>Marketing_Templates/Email_to_Current_Approver</emailTemplate>
    <enableMobileDeviceAccess>false</enableMobileDeviceAccess>
    <entryCriteria>
        <formula>RecordType.Name  = &quot;Customer Promotion&quot;</formula>
    </entryCriteria>
    <finalApprovalActions>
        <action>
            <name>Create_Promo_Flyer</name>
            <type>Task</type>
        </action>
        <action>
            <name>Create_Promo_Report</name>
            <type>Task</type>
        </action>
        <action>
            <name>Update_Status_to_Pending</name>
            <type>FieldUpdate</type>
        </action>
    </finalApprovalActions>
    <finalApprovalRecordLock>false</finalApprovalRecordLock>
    <finalRejectionRecordLock>false</finalRejectionRecordLock>
    <initialSubmissionActions>
        <action>
            <name>Change_Status_to_Pending_Mrktng_Approval</name>
            <type>FieldUpdate</type>
        </action>
        <action>
            <name>Promotion_Request_Submitted_for_Approval</name>
            <type>Alert</type>
        </action>
    </initialSubmissionActions>
    <label>Promotion Request Active ApprovalProcess</label>
    <nextAutomatedApprover>
        <useApproverFieldOfRecordOwner>false</useApproverFieldOfRecordOwner>
        <userHierarchyField>Manager</userHierarchyField>
    </nextAutomatedApprover>
    <processOrder>2</processOrder>
    <recordEditability>AdminOrCurrentApprover</recordEditability>
    <showApprovalHistory>true</showApprovalHistory>
</ApprovalProcess>
