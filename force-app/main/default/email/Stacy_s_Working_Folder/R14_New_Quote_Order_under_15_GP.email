<messaging:emailTemplate subject="R14 {!relatedTo.Type__c} with GP <15% for {!relatedTo.Customer_Name__c}" 
    recipientType="User" 
    relatedToType="QuotesOrdersCredits_Header__c" 
    replyTo="wfiore@omnicable.com">

    <messaging:htmlEmailBody >
        <html>
            <body style="font-family: Arial, sans-serif; font-size: 14px;">

                <p><strong>R14 {!relatedTo.Type__c} with GP &lt;15% has been entered by</strong> {!relatedTo.Entered_By__r.Name}</p>
                <p>
                    <strong>{!relatedTo.Type__c} #{!relatedTo.Name}</strong><br/>
                    <strong>Customer:</strong> {!relatedTo.Customer_Name__c}<br/>
                    <strong>Buyer:</strong> {!relatedTo.buyer__r.Name}<br/>
                    <strong>Total:</strong> ${!relatedTo.Total_Order_Sales__c}<br/>
                    <strong>Total GP% (Booked):</strong> {!relatedTo.Total_Order_GP_Pct__c}%<br/>
                </p>
                <p><strong>AM on Order:</strong> {!relatedTo.Inside_AM_Name__r.Name}<br/>
                </p>
                <p>Click here to view the record in Salesforce: https://omnicable.my.salesforce.com/{!relatedTo.Id}
                </p>

            </body>
        </html>
    </messaging:htmlEmailBody>
</messaging:emailTemplate>