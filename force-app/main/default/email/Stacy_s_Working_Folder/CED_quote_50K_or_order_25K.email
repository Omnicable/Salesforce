<messaging:emailTemplate subject="CED {!relatedTo.Type__c} {!IF(
        relatedTo.Type__c = 'Order',
        'over $25K',
        IF(relatedTo.Type__c = 'Quote', 'over $50K', '')
    )} for {!relatedTo.Customer_Name__c}"
    recipientType="User"
    relatedToType="QuotesOrdersCredits_Header__c"
    replyTo="wfiore@omnicable.com">

<messaging:htmlEmailBody >
    <html>
        <body style="font-family: Arial, sans-serif; font-size: 14px;">

            <p>
                <strong>
                    CED {!relatedTo.Type__c}
                    {!IF(
                        relatedTo.Type__c = 'Order',
                        '>$25K',
                        IF(relatedTo.Type__c = 'Quote', '>$50K', '')
                    )}
                    has been entered by</strong> {!relatedTo.Entered_By__r.Name}</p>
            <p>
                <strong>Quote #{!relatedTo.Name}</strong><br/>
                <strong>Customer:</strong> {!relatedTo.Customer_Name__c}<br/>
                <strong>Buyer:</strong> {!relatedTo.Buyer__r.Name}<br/>
                <strong>Total:</strong> ${!relatedTo.Total_Order_Sales__c}<br/>
                <strong>Total GP% (Booked):</strong> {!relatedTo.Total_Order_GP_Pct__c}%<br/>
            </p>

            <p>
                <strong>AM on Order:</strong>
                {!relatedTo.Inside_AM_Name__r.Name}
            </p>

            <p>
                Click here to view the record in Salesforce:
                https://omnicable.my.salesforce.com/{!relatedTo.Id}
            </p>

        </body>
    </html>
</messaging:htmlEmailBody>

</messaging:emailTemplate>