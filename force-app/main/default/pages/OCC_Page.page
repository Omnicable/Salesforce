                $scope.deleteApprovedAccount = function (account) {

                    var retVal = confirm("Are you sure you want to delete access to " + account.Name);
                    if (retVal == true) {


                        var wrapper = new Object();
                        //wrapper['currAccount'] = account;
                        wrapper['Name'] = account.Name;
                        wrapper['Id'] = account.Id;

                        var request = { params: JSON.stringify(wrapper) };

                        do_execute_service_callback("OCCommunitiesResource", "deleteAccountAccess", request, function (result) {

                            if (result['Success'] == 'true') {
                                toastr.success(result['Message']);
                                var deletedId = result['DeletedId'];

                                for (var i = 0; i < $scope.AllAccounts.length; i++) {
                                    var currAccount = $scope.AllAccounts[i];
                                    if (currAccount.Account__c == deletedId) {
                                        currAccount['checked'] = false;
                                        currAccount['disabled'] = false;
                                        currAccount['status'] = 'No Access';
                                        currAccount['orginalValue'] = currAccount['checked'];
                                        break;
                                    }
                                }

                                $scope.$apply();

                            } else {
                                toastr.error(result['Message']);
                            }
                        }, true);

                        return true;
                    } else {
                        return false;
                    }

                }

                $scope.requestAccess = function () {

                    var newRequest = [];
                    var deleteRequest = [];

                    for (var i = 0; i < $scope.AllAccounts.length; i++) {
                        var currAccount = $scope.AllAccounts[i];
                        if (currAccount['orginalValue'] != currAccount['checked']) {

                            if (currAccount['checked'] == true) {
                                newRequest.push({ Name: currAccount.Name, Account: currAccount.Id });
                            } else {
                                deleteRequest.push(currAccount.Id);
                            }

                        }
                    }



                    var wrapper = new Object();
                    wrapper['Added'] = newRequest;
                    wrapper['DeletedIds'] = deleteRequest;
                    wrapper['RegionalManagerId'] = $scope.RegionalManager.Id;

                    var request = { params: JSON.stringify(wrapper) };

                    do_execute_service_callback("OCCommunitiesResource", "requestAccountAccess", request, function (result) {

                        if (result['Success'] == 'true') {
                            toastr.success(result['Message']);
                            ///////

                            var requestedIds = result['requestedIds'];

                            if (typeof requestedIds == 'undefined') {
                                requestedIds = [];
                            } else if (!Array.isArray(requestedIds)) {
                                requestedIds = [requestedIds];
                            }

                            for (var i = 0; i < $scope.AllAccounts.length; i++) {
                                var currAccount = $scope.AllAccounts[i];
                                for (var j = 0; j < requestedIds.length; j++) {

                                    if (currAccount['Id'] == requestedIds[j]) {
                                        currAccount['checked'] = false;
                                        currAccount['disabled'] = true;
                                        currAccount['status'] = 'Pending';
                                        currAccount['orginalValue'] = currAccount['checked'];
                                    }

                                }

                            }

                            $scope.$apply();

                        } else {
                            toastr.error(result['Message']);
                        }
                    }, true);
                }

