                $scope.isQuoteExpired = function (createdDate) {

                    var today = new Date();
                    today.setHours(0, 0, 0, 0);

                    var created = new Date(createdDate);
                    created.setHours(0, 0, 0, 0);

                    var hours = Math.abs(today - created) / 36e5;
                    if (hours > 72) {
                        return true;
                    } else {
                        return false;
                    }

                }

