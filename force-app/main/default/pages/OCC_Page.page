                                        <span style="width:10%;padding-top:10px; vertical-align: middle; padding-top:15px; display:inline-block;">X</span>
                                        <input onkeypress="return isNumberKey(event)" ng-change="updateTotal(request)" ng-minlength="1" required="true" style="width:45%; float:right;"
