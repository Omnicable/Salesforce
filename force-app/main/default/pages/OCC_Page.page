                $scope.selectMasterOrder = function (allQuotes, quote) {

                    if (quote.selected != false) {

                        if ($scope.Requests.length > 0) {
                            var confirm = window.confirm('Changing the Master Order will clear out the current Request Release.  Would you like to continue?');
                            if (confirm) {
                                $scope.masterOrder = quote;
                                $scope.Requests = [];
                                $scope.newRequest['pullingHeads'] = 'None';/* = {pullingHeads:'None'};*/
                                for (let index = 0; index < allQuotes.length; index++) {
                                    const element = allQuotes[index];
                                    if (element.header.Id != quote.header.Id) {
                                        element.selected = false;
                                    }
                                }
                            } else {
                                quote.selected = true;
                            }

                        } else {
                            //NOTE: Changing master order resets current release request
                            $scope.Requests = [];
                            $scope.newRequest['pullingHeads'] = 'None';/* = {pullingHeads:'None'};*/
                            $scope.masterOrder = quote;
                            for (let index = 0; index < allQuotes.length; index++) {
                                const element = allQuotes[index];
                                if (element.header.Id != quote.header.Id) {
                                    element.selected = false;
                                }
                            }
                        }



                    } else {
                        quote.selected = true;
                    }

