                top: 10px;
                position: absolute;
            }

            .reel-img {
                width: 100px;
                height: auto;
                text-align: center;
                font-size: 90px;
                float: left;
                margin: 15px;
            }

            .reel-logo {
                margin-bottom: 15px;
            }

            .recent-container .panel-group {
                border: none;
            }

            .editable-content {
                min-height: 82vh;
            }



