                            <div class="no-release"></div>
                            <h2>No Releses Available For This Order</h2>
                        </div>


                        <div class="" style="font-size: 1.2em; padding: 2px 8px; font-weight:bold; left:10px; top:20%; position: absolute; color:#0074BF;">Add
                            <br></br> Line</div>

                        <div class="col-xs-12" style="padding-left:50px; padding-right:50px;">
                            <form class="newRequestForm" name="newRequestForm">
                                <div class="col-md-3 col-xs-12 rma-row" style="display: inline-block; text-align:center;">
                                    <div class="col-xs-6" style="text-align:left; font-weight:bold; padding-left:0px;">Qty:</div>
                                    <div class="col-xs-6" style="text-align:left; font-weight:bold;">Length:</div>
                                    <input onkeypress="return isNumberKey(event)" style="width:45%;" class="col-xs-6 form-control request-row" ng-model="newRequest.qty"
                                        ng-minlength="1" required="true" type="text" placeholder="Qty: 2" />
                                    <span style="width:10%;padding-top:10px; vertical-align: middle; padding-top:15px; display:inline-block; font-weight:bold;">X</span>
                                    <input onkeypress="return isNumberKey(event)" name="newRequestLength" ng-minlength="1" required="true" style="width:45%; float:right;"
                                        class="col-xs-6 form-control request-row" ng-model="newRequest.length" type="text" placeholder="Length: 500"
                                    />
                                </div>
                                <div class="col-md-2 col-xs-12 rma-row">
                                    <div style="font-weight:bold;">Cable #:</div>
                                    <input type="text" ng-model="newRequest.item" placeholder="Search Cable #" uib-typeahead="item as item.Name for item in filteredAlternativePartNumbers | filter:{Name:$viewValue} | limitTo:25"
                                        class="col-xs-12 form-control request-row" typeahead-show-hint="true" typeahead-min-length="0"
                                        typeahead-on-select="newRequestChange(newRequest.item)" />
                                </div>

                                <div class="col-md-3 col-xs-12 rma-row">
                                    <div style="font-weight:bold;">Description:</div>
                                    <input class="col-xs-12 form-control request-row" ng-model="newRequest.itemDescription" type="text" placeholder="Item Description: 12/4c tray"
                                        disabled="true" />
                                </div>
                                <div class="col-md-4 col-xs-12 rma-row">
                                    <div style="font-weight:bold;">Additional Info:</div>
                                    <input class="col-xs-12 form-control request-row" ng-model="newRequest.addInfo" type="text" placeholder="Additional Info: Please ship on plastic reels"
                                    />
                                </div>
                                <!-- <div class="col-md-1 col-xs-12 rma-row">
	                                            <input class="col-xs-12  request-row" ng-model="newRequest.totalQuantity"  type="text" placeholder="Field is Autocompleted" disabled="true"/>
	                                        </div> -->
                                <!-- <div class="col-md-1 rma-row">
	                                            <button class="col-xs-12  request-row omni-btn" style="padding-top:5px; padding-bottom:5px" ng-click="addItem(newRequest)">Add</button>
                                            </div> -->

                                <div class="col-md-3 col-xs-12 rma-row" style="margin-top:10px;">
                                    <div style="font-weight:bold;">Area</div>
                                    <!-- <span style="color:red;">*</span> -->
                                    <select ng-options="area as area.Name for area in req.areas track by area.Id" ng-model="newRequest.area" class="col-xs-6 form-control"
                                        required="true">
                                    </select>
                                </div>

                                <div class="col-xs-6 col-lg-2 col-md-2" style="margin-top:35px; padding-left: 10px;">
                                    <div class="col-xs-12" style="padding-left:0px;">
                                        <input ng-model="newRequest.paralleling" type="checkbox" style="float:left;"></input>
                                        <span class="checkbox-label">Paralelling</span>
                                    </div>
                                </div>

                                <div class="col-xs-3" style="margin-top:35px; padding-left: 10px;">
                                    <div class="col-xs-12" style="padding-left:0px;">
                                        <!-- <input ng-model="newRequest.pullingHeads" type="checkbox" style="float:left;"></input> -->
                                        <input type="radio" ng-model="newRequest.pullingHeads" value="Attach Pulling Heads" style="float:left;" />

                                        <span class="checkbox-label">Attach Pulling Heads</span>
                                        <span class="col-xs-12" style="font-style: italic; font-style: italic; color: gray; font-size: .9em;">*Pulling heads 2# and larger Tray Cable</span>
                                        <div class="col-xs-12" style="font-style: italic; font-style: italic; color: gray; font-size: .9em;">Additional Lead-time</div>

                                    </div>
                                </div>

                                <div class="col-xs-3" style="margin-top:35px; padding-left: 10px;">
                                    <!-- <input ng-model="newRequest.includePullingHeads" type="checkbox" style="float:left;"></input> -->
                                    <input type="radio" ng-model="newRequest.pullingHeads" value="Include Pulling Heads" style="float:left;" />
                                    <div class="checkbox-label">Include Pulling Heads</div>
                                    <div class="col-xs-12" style="font-style: italic; font-style: italic; color: gray; font-size: .9em;">*NOT Attached No additional Lead-Time</div>
                                </div>

                                <div class="col-xs-1" style="margin-top:35px; padding-left: 10px;">
                                    <!-- <input ng-model="newRequest.includePullingHeads" type="checkbox" style="float:left;"></input> -->
                                    <input type="radio" ng-model="newRequest.pullingHeads" value="None" style="float:left;" />
                                    <div class="checkbox-label">None</div>
                                </div>

                                <span ng-if="newRequest.item != null">{{::}}</span>


                            </form>

                        </div>


                        <i class="ng-scope glyphicon glyphicon-plus-sign clickable" ng-click="addItem(newRequest)" style="font-size: 2em; right:8px; top:35%; position: absolute; color:#0074BF;"></i>

                    </div>
                    <div class="col-xs-12 row-padding" style="margin-top:10px; margin-bottom:8px;">
