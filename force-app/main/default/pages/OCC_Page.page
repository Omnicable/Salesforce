                        <div class="col-md-4" style="margin-top:15px;">
                            <span style="font-weight:bold;">RMF PO #</span>
                            <span style="color:red;">*</span>
                            <select ng-options="value as value for value in rmfPOValues" ng-model="req.rmfPO" class="col-xs-6 form-control" required="true"
                                ng-init="req.rmfPO = rmfPOValues[0]">
                            </select>


                        </div>

