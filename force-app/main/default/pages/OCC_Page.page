                $scope.addAllItems = function (qoc, type) {
                    //
                    $scope.RFQMixPanelTitle = type;
                    $scope.RequotedQuote = qoc.header;
                    var lineItems = qoc['details'];
                    if (typeof lineItems == 'undefined') {
                        lineItems = [];
                    } else if (!Array.isArray(lineItems)) {
                        lineItems = [lineItems];
                    }

                    for (var i = 0; i < lineItems.length; i++) {
                        if (typeof lineItems[i]['putups'] == 'undefined') {
                            lineItems[i]['putups'] = [];
                        } else if (!Array.isArray(lineItems[i]['putups'])) {
                            lineItems[i]['putups'] = [lineItems[i]['putups']];
                        }


                        if (lineItems[i]['putups'].length == 0) {

                            var totalQ = Number(lineItems[i].Qty_Ordered__c) * 1;
                            $scope.Requests.push({ 'qty': 1, 'length': lineItems[i].Qty_Ordered__c, 'itemNumber': lineItems[i].Line_Item__c, 'itemDescription': lineItems[i].Item_Description__c, 'totalQuantity': totalQ });

                        } else {

                            for (var j = 0; j < lineItems[i]['putups'].length; j++) {
                                var split = lineItems[i]['putups'][j].toLowerCase().split('x');

                                var qty = split[0].trim();
                                var length = split[1].trim();

                                var totalQ = Number(qty) * Number(length);
                                $scope.Requests.push({ 'qty': qty, 'length': length, 'itemNumber': lineItems[i].Line_Item__c, 'itemDescription': lineItems[i].Item_Description__c, 'totalQuantity': totalQ });

                            }

                        }



                    }

                    if ($scope.Requests.length == 0) {
                        toastr.error('There are no Put-ups available to add.');
                    } else {
                        toastr.success('Line items added to your request.');
                    }

                }


