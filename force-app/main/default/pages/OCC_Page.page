        function getFileArray(files, callback) {
            var total = files.length;
            var count = 0;
            var fileArray = [];
            if (files.length != 0) {
                for (var i = 0; i < files.length; i++) {
                    var file = files[i];
                    if (file != null) {
                        var reader = new FileReader();
                        reader.onload = (function (file) {
                            return function (e) {


                                var title = file.name;
                                var baseendoed = e.target.result.split(',')[1];
                                var imageData = { name: title, image: baseendoed };

                                fileArray.push(imageData);
                                count++;
                                //alert(count + ' => ' + total);
                                if (count == total) {
                                    callback(fileArray);
                                }

                            };
                        })(file);
                        reader.readAsDataURL(file);

                    } else {
                        count++;
                    }
                }

            } else {
                callback(fileArray);
            }


        }


