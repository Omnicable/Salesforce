                    </div>
                    <div class="col-xs-6 profile-row" style="vertical-align:middle; padding:20px;text-align:center;">
                        <span style="font-weight: bold; padding-top:5px; margin-right: 10px;">What is the best way to contact you?</span>
                        <select class="col-xs-12 form-control" style="text-align:center;" ng-model="requestRMA.contactMethod" ng-init="requestRMA.contactMethod = '--Choose One--'">
							<option value="--Choose One--">--Choose One--</option>
