                        	<option value="--Choose One--">--Choose One--</option>
                            <option value="End user cancelled order">End user cancelled order</option>
                            <option value="Ordered by mistake">Ordered by mistake</option>
                            <option value="Over ordered quantity">Over ordered quantity</option>
                            <option value="Ordered wrong length(s)">Ordered wrong length(s)</option>
                            <option value="Other (Please explain below)">Other (Please explain below)</option>
                        </select> 
                    </div>
                    <div class="col-xs-12 profile-row" style="vertical-align:middle;">
                        <div style="font-weight: bold; padding:5px 0px 0px 0px; margin-right: 10px; width: 100%;" class="col-xs-12">Additional Information:</div>
