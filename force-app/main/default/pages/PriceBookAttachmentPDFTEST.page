                      <div>{!pb.Name}</div>
                    <div>{!pb.Synced_Date__c}</div>
                        <apex:outputText value="{0, date, MMMM  yyyy}">
                            <apex:param value="{!PB.Synced_Date__c}" />
                        </apex:outputText>
                        Price Sheetss
                    </h1>
                </td>
                <td style="width: 33%;text-align:right; font-size:10px">
                    <div>
                        <div>{!pba.Freight_Terms_Line_1__c}</div>
                        <div>{!pba.Freight_Terms_Line_2__c}</div>
                        <div>{!pba.Freight_Terms_Line_3__c}</div>
                        <div>{!pba.Freight_Terms_Line_4__c}</div>
                         <div>{!pb.Synced_Date__c}</div>
                    </div>


                </td>
            </tr>
        </table>
    </div>

