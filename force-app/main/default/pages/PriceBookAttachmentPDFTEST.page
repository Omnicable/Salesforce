<apex:page controller="PriceSheetController" showHeader="false" renderAs="HTML"  applyBodyTag="false" applyHtmlTag="false">


    <html xmlns="http://www.w3.org/2000/svg" xmlns:xlink="http://www.w3.org/1999/xlink" lang="en">

    <head>

        <style type="text/css" media="print">
            @page {

                @bottom-center {
                    content: element(footer);
                }

                @top-center {
                    content: element(header);
                }

                margin-left: 20px;
                margin-right: 20px;
                margin-top: 45px;
                margin-bottom: 30px;
                size: A4 landscape;

            }

            .page {
                position: relative;
            }

            body {
                margin-top: 0;
            }

            h1 {
                font-size: 15px;
                text-transform: uppercase;
            }

            .category {
                border: 2px solid black;
                margin-top: 20px;
                width: 99%;
                margin-left: 3px;
                text-align: center;
                margin-bottom: 5px;
            }

            .report-cont .page-break:not(:last-child) {
                page-break-after: always;
            }

            div.header {
                margin-top: 10px;
                position: running(header);
            }

            div.footer {
                margin-bottom: 50px;
                text-align: center;
                position: running(footer);
            }


            .report-title {
                font-weight: bold;
                font-size: 16px;
                padding-bottom: 5px;
            }


            body {
                font-size: 12px;
                font-family: calibri, Arial, Helvetica, sans-serif;
            }

            .category {
                text-transform: uppercase;
            }

            .logo img {
                height: 60px;
            }

            .logo p {
                margin: 0px;
            }

            table table {
                border: 2px solid black;
            }


            table.part {
                font-family: Arial, Helvetica, sans-serif;
                font-size: 8px;
                /* border-collapse: collapse; */
                border: 2px solid black;
                width: 100%;
                text-transform: uppercase;
                text-align: center;
            }

            .part td,
            .part th {
                /* border-top: 2px solid black;
                border-bottom: 2px solid black;
                border-left: 2px solid black;
                border-right: 2px solid black; */
                /* border-top: 2px solid black; */
                padding: 1px;
            }

            .part thead tr:last-of-type {
                border-right: 2px solid white;

            }

            .part th:last-of-type {
                border-right: 2px solid red;

            }

            .part tr:nth-child(even) {
                background-color: #f2f2f2;
            }

            .part th {
                padding-top: 1px;
                padding-bottom: 1px;
                text-align: left;
                background: #d9d9d9;
                color: black;
                text-align: center;
                border-bottom: 2px solid black;
                border-left: 2px solid white;

            }

            .part th:first-child {
                border-left: none;
            }

            .part thead tr:last-child {
                text-align: center;
                color: white;
                background-color: gray !important;
                border: 2px solid black !important;
                text-transform: uppercase;
            }

            tfoot tr {
                font-size: 6px;
                border-top: 2px solid black !important;
            }


            table td,
            table td * {
                vertical-align: top;
            }

            table.part {
                margin-bottom: 5px;
            }

            .even {
                background: #d9d9d9;
            }

            .part tbody td:not(:first-of-type) {
                border-left: 2px solid white;
                /* border-right: 2px solid white; */
            }

            .part tr td {
                border-left: 2px solid white;
                /* border-right: 2px solid white; */
            }

            table tr td:first-child {
                border-left: 0;
            }

            .part thead tr:first-child th {
                background-color: #006ebd;
                color: white;
            }

            h1 {
                text-transform: uppercase;
            }
        </style>
    </head>
    <div class="footer">
        Contact us today. > 800-292-OMNI | omnicable.com / 800-HOU-WIRE | houwire.com
